#!/usr/bin/env zsh
# =============================================================================
# zbase — Verb-root namespace primitives for zsh
# =============================================================================
# Description:  Foundation layer of zcore. Every public entry point sits
#               under a verb root that encodes its return-channel contract:
#               z::is:: are silent predicates, z::ensure:: are logging
#               guards, z::get:: are value queries, z::set:: are state
#               mutators, and z::do:: performs effects. The name alone
#               therefore tells a caller whether to branch on $? or to read
#               REPLY; the contract is restated in full below the constants.
#               Loading is idempotent and zlog must already be sourced, or
#               the load aborts.
#
# Usage:        source zbase          # after zlog
#               z::is::file "$p" || return
#               z::get::realpath "$p" && print -r -- "$REPLY"
#
# Public API:   z::is::*, z::ensure::*, z::get::*, z::set::*, z::do::*
# Private API:  _z::*, _Z_*  (internal — no compatibility guarantee)
#
# Requires:     zlog  — structured logging; must be sourced first
#
# Provides:     Z_SEP/Z_RECSEP/Z_ESC — binary-safe separators shared with
#               zkv and zbus; Z_ERR_* — the flat zcore error-code set
#
# Version:      3.0.0
# License:      MIT
# =============================================================================


# =============================================================================
# LOAD GUARD AND DEPENDENCIES
# =============================================================================

# Re-sourcing must be free: the readonly constants below abort the load if
# they are assigned a second time.
(( ${+_Z_BASE_LOADED} )) && return 0

# Hard dependency — every ensure:: guard reports through zlog, so a missing
# logger is a load-time failure rather than a runtime surprise.
if (( ! ${+functions[zlog::error]} )); then
    print -u2 "zbase: fatal: zlog must be sourced before zbase"
    return 1 2>/dev/null || exit 1
fi


# =============================================================================
# CONSTANTS
# =============================================================================

# -----------------------------------------------------------------------------
# Binary separators — cross-component contract with zkv and zbus
# -----------------------------------------------------------------------------
#   Z_SEP    \x01  unit separator   (field delimiter)
#   Z_RECSEP \x02  record delimiter
#   Z_ESC    \x03  escape prefix
#
# Guarded because they are readonly: a bare assignment on a second load
# would fail instead of being ignored.
(( ${+Z_SEP} ))    || typeset -gr Z_SEP=$'\x01'
(( ${+Z_RECSEP} )) || typeset -gr Z_RECSEP=$'\x02'
(( ${+Z_ESC} ))    || typeset -gr Z_ESC=$'\x03'

# Error codes — one flat set for all of zcore, so a module never has to
# translate between its own numbering and zbase's.
typeset -gri Z_ERR_GENERAL=1
typeset -gri Z_ERR_INPUT=2
typeset -gri Z_ERR_NOTFOUND=3
typeset -gri Z_ERR_PERM=4

# Version — single source of truth; the load banner reads this constant
# rather than repeating a literal.
typeset -g  _Z_BASE_VERSION='3.0.0'


# =============================================================================
# RETURN-CHANNEL CONTRACT
# =============================================================================
# The verb root of a public name is a promise about the return channels:
#
#   z::is::      never touches REPLY/reply/REPLY2 — branch on $?
#   z::ensure::  never touches REPLY — returns a code, logs on failure
#   z::get::     ALWAYS sets REPLY (reply= for lists), reset on entry
#   z::set::     never touches REPLY — status only
#   z::do::      touches REPLY only where documented (run_async job id)
#
# REPLY2 carries a documented secondary scalar and nothing else.
#
# CAVEAT: every zlog:: helper clobbers REPLY. A function that logs before
# returning a value must (re)assign REPLY *after* its last log call.


# =============================================================================
# MODULE STATE
# =============================================================================

# Declared up-front so functions running under `warncreateglobal` can assign
# the return channels without emitting "created globally" warnings.
typeset -g  REPLY REPLY2
typeset -ga reply

# Tunables: symlink-walk depth cap, z::do::run timeout default and ceiling,
# a perf switch that skips optional work, and the async job cap.
typeset -gi _Z_FILE_SYMLINK_MAX_ITER=40
typeset -gi _Z_EXEC_TIMEOUT_DEFAULT=30
typeset -gi _Z_EXEC_TIMEOUT_MAX=3600
typeset -gi _Z_PERF_MODE=0
typeset -gi _Z_EXEC_ASYNC_MAX_PIDS=50

# Tools whose `<tool> init <shell>` invocation z::do::run may execute
# without the metacharacter gate — see _z::do::run::is_init_cmd.
if (( ! ${+_Z_EXEC_INIT_CMDS} )); then
    typeset -ga _Z_EXEC_INIT_CMDS=(
        starship mise direnv zoxide atuin mcfly fzf oh-my-posh
    )
fi

# Rejected-character set for command strings handed to z::do::run: every
# operator that can turn one command into a compound one, plus a literal
# newline and the redirection operators.
# SAFETY: `|` is in the set because a pipeline is a compound command like
# any other — `foo | bar` must be refused exactly as `foo && bar` is via
# `&`. Omitting it would leave an unchecked path to arbitrary execution.
# SAFETY: each pattern is guarded on its own — an empty regex makes
# [[ =~ ]] match every input, so overriding one must never leave another
# unset.
(( ${+_Z_EXEC_META_RE} ))       || typeset -g _Z_EXEC_META_RE='[;&|()<>'$'\n'']'
(( ${+_Z_EXEC_FORKBOMB_RE_1} )) || typeset -g _Z_EXEC_FORKBOMB_RE_1=':\(\)'
(( ${+_Z_EXEC_FORKBOMB_RE_2} )) || typeset -g _Z_EXEC_FORKBOMB_RE_2=':\|:'

# Live background jobs started by z::do::run_async; harvested by z::do::wait.
(( ${+_Z_EXEC_ASYNC_PIDS} )) || typeset -ga _Z_EXEC_ASYNC_PIDS=()

# zsh/stat lets z::get::realpath read link targets without forking readlink.
typeset -gi _Z_HAVE_ZSTAT=0
zmodload zsh/stat 2>/dev/null && _Z_HAVE_ZSTAT=1

# zsh/datetime supplies $EPOCHSECONDS/$EPOCHREALTIME for fork-free clocks.
zmodload zsh/datetime 2>/dev/null

# GNU coreutils installs as gtimeout on macOS. With neither binary present
# z::do::run still runs the command, just without a time limit.
typeset -g _Z_EXEC_TIMEOUT_CMD=""
if (( ${+commands[gtimeout]} )); then
    _Z_EXEC_TIMEOUT_CMD="${commands[gtimeout]}"
elif (( ${+commands[timeout]} )); then
    _Z_EXEC_TIMEOUT_CMD="${commands[timeout]}"
fi


# =============================================================================
# TIME PRIMITIVES — Z::GET::
# =============================================================================
# All of these set REPLY and stay fork-free whenever the zsh/datetime
# parameters are available, because they sit on prompt-render hot paths.

# z::get::epoch
# Read the current time in whole seconds since the epoch.
# Sets REPLY; clears REPLY2 and reply. Always returns 0.
z::get::epoch() {
    REPLY2=""; reply=()
    if (( ${+EPOCHSECONDS} )); then
        REPLY=$EPOCHSECONDS
    else
        REPLY=$(date +%s)
    fi
}

# z::get::epoch_ms
# Read the current time in milliseconds since the epoch.
# Sets REPLY; clears REPLY2 and reply. The fractional part of $EPOCHREALTIME
# is right-padded before truncation so a short fraction is not misread as a
# larger one. Always returns 0.
z::get::epoch_ms() {
    REPLY2=""; reply=()
    if (( ${+EPOCHREALTIME} )); then
        local er=$EPOCHREALTIME
        local sec=${er%.*} frac=${er#*.}
        while (( ${#frac} < 6 )); do frac="${frac}0"; done
        REPLY="${sec}${frac[1,3]}"
    else
        REPLY=$(date +%s%3N 2>/dev/null) || REPLY=$(( $(date +%s) * 1000 ))
    fi
}

# z::get::epoch_ns
# Read the current time in nanoseconds since the epoch.
# Sets REPLY; clears REPLY2 and reply. $EPOCHREALTIME carries only
# microsecond resolution, so the final three digits are always zero.
# Always returns 0.
z::get::epoch_ns() {
    REPLY2=""; reply=()
    if (( ${+EPOCHREALTIME} )); then
        local er=$EPOCHREALTIME
        local sec=${er%.*} frac=${er#*.}
        while (( ${#frac} < 6 )); do frac="${frac}0"; done
        REPLY="${sec}${frac}000"
    else
        REPLY=$(date +%s%N 2>/dev/null) || REPLY="$(( $(date +%s) * 1000000000 ))"
    fi
}

# z::get::mono_ms
# Read a millisecond timestamp for interval measurement. Sets REPLY.
# NOTE: zsh exposes no monotonic clock, so this is wall-clock time and a
# system clock adjustment can make two successive readings go backwards.
z::get::mono_ms() { z::get::epoch_ms; }


# =============================================================================
# SILENT PREDICATES — Z::IS::
# =============================================================================
# Every predicate here answers through $? alone: no logging, no fork, and
# the return channels are left exactly as the caller left them. A missing or
# empty argument is a "no" (return 1), never an error.

# -----------------------------------------------------------------------------
# Filesystem tests — thin wrappers over [[ -f/-d/-r/-w/-x ]]
# -----------------------------------------------------------------------------
# Each takes a single <path> and returns 0 when the test holds. They follow
# symlinks, exactly as the underlying conditional expression does.
z::is::file()     { [[ -f ${1:-} ]]; }
z::is::dir()      { [[ -d ${1:-} ]]; }
z::is::readable() { [[ -r ${1:-} ]]; }
z::is::writable() { [[ -w ${1:-} ]]; }
z::is::exec()     { [[ -x ${1:-} ]]; }

# z::is::cmd <name>
# Report whether the name is runnable in this shell in any form — external
# command, function, builtin, or alias. Consults the shell's own tables, so
# it neither forks nor walks $PATH on disk.
z::is::cmd() {
    [[ -n ${1:-} ]] || return 1
    (( ${+commands[$1]} || ${+functions[$1]} || ${+builtins[$1]} || ${+aliases[$1]} ))
}

# -----------------------------------------------------------------------------
# Shell-table tests — each takes a single <name>
# -----------------------------------------------------------------------------
# z::is::func, z::is::builtin and z::is::alias probe one table apiece.
# z::is::var reports only that the parameter is declared: a variable declared
# and left empty still answers yes.
z::is::func()    { [[ -n ${1:-} ]] && (( ${+functions[$1]} )); }
z::is::builtin() { [[ -n ${1:-} ]] && (( ${+builtins[$1]}  )); }
z::is::alias()   { [[ -n ${1:-} ]] && (( ${+aliases[$1]}   )); }
z::is::var()     { [[ -n ${1:-} ]] && (( ${+parameters[$1]} )); }

# z::is::set <name>
# Alias of z::is::var, for call sites that read better as "is it set". The
# contract is identical: the parameter is declared, not necessarily non-empty.
z::is::set()   { [[ -n ${1:-} ]] && (( ${+parameters[$1]} )); }

# z::is::empty <value>
# Report whether the value is the empty string. Takes the value itself, not
# a variable name — contrast z::is::set.
z::is::empty() { [[ -z ${1:-} ]]; }

# z::is::blank <value>
# Report whether the value is empty or consists only of whitespace.
# The `#` closure needs extendedglob, which callers under `emulate -L zsh`
# do not have; localoptions keeps the option change scoped to this call.
z::is::blank() { setopt localoptions extendedglob; [[ ${1:-} == [[:space:]]# ]]; }

# z::is::assoc <name>
# Report whether the named parameter exists and is an associative array.
# Takes the name, not the value — the type is read via ${(Pt)}.
z::is::assoc() {
    emulate -L zsh; setopt extendedglob
    [[ -n ${1:-} ]] || return 1
    (( ${+parameters[$1]} )) || return 1
    [[ ${(Pt)1} == *association* ]]
}

# z::is::array <name>
# Report whether the named parameter exists and is an array. Associative
# arrays also carry "array" in their type string, so this answers yes for
# them too — use z::is::assoc to tell the two apart.
z::is::array() {
    [[ -n ${1:-} ]] || return 1
    (( ${+parameters[$1]} )) || return 1
    [[ ${(Pt)1} == *array* ]]
}

# z::is::int <value>
# Report whether the value is a canonical decimal integer: an optional
# minus sign, no leading zeros, and no surrounding whitespace.
# Without extendedglob the `#` closure is literal and every multi-digit
# number reports as a non-integer, so localoptions enables it here.
z::is::int()  { setopt localoptions extendedglob; [[ ${1:-} == (-[1-9][0-9]#|[0-9]|[1-9][0-9]#) ]]; }

# z::is::bool <value>
# Report whether the value is one of the accepted truth spellings — 0, 1,
# true, false, yes, no, on, off — compared case-insensitively. This tests
# spelling only; it does not report which way the value points.
z::is::bool() {
    case "${(L)1:-}" in (0|1|true|false|yes|no|on|off) return 0;; esac
    return 1
}

# z::is::opt <opts-assoc-name> [short-opt] [long-opt]
# Report whether an options map holds `-<short-opt>` or `--<long-opt>`.
# The first argument is the *name* of an associative array, copied through
# ${(@kvP)} so the caller's map is never modified. Returns 1 when the name
# is empty, both option names are empty, or the parameter is not an assoc.
z::is::opt() {
    emulate -L zsh; setopt extendedglob
    local opts_var="${1:-}" short_opt="${2:-}" long_opt="${3:-}"
    [[ -n $opts_var ]] || return 1
    [[ -n $short_opt || -n $long_opt ]] || return 1
    z::is::assoc "$opts_var" || return 1
    local -A _opts=( "${(@kvP)opts_var}" )
    [[ -n $short_opt && -n ${_opts[-$short_opt]+x} ]] && return 0
    [[ -n $long_opt  && -n ${_opts[--$long_opt]+x} ]] && return 0
    return 1
}

# z::is::path <dir>
# Report whether the directory is present in $path. The argument is
# absolutised first, so a relative or `~`-prefixed form still matches.
# Matching uses the (Ie) subscript flag, which compares literally; a plain
# (I) would treat the directory name as a glob pattern.
z::is::path() {
    emulate -L zsh; setopt extendedglob
    [[ -n ${1:-} ]] || return 1
    # is:: must leave the return channels untouched, and z::get::abspath
    # resets them — so save and restore them around the call.
    local _saved_reply="$REPLY" _saved_reply2="$REPLY2"
    local -a _saved_list=( "${reply[@]}" )
    z::get::abspath "$1"
    local dir="$REPLY"
    REPLY="$_saved_reply"; REPLY2="$_saved_reply2"; reply=( "${_saved_list[@]}" )
    (( ${path[(Ie)$dir]} ))
}


# =============================================================================
# GUARDS — Z::ENSURE::
# =============================================================================
# Each guard validates one condition, logs through zlog on failure, and
# reports only through its exit status — the return channels are never used
# for a result, though zlog itself clobbers REPLY on the failure paths.
# Most take a trailing field name used purely to label the log record.

# z::ensure::set <name> [context]
# Require that the named parameter is declared. Logs an error naming
# <context> (default "Variable") and returns 1 when it is not.
z::ensure::set() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local name="${1:-}" context="${2:-Variable}"
    if [[ -z $name ]] || (( ! ${+parameters[$name]} )); then
        zlog::error "${context} is not set" field "$context"
        return 1
    fi
    return 0
}

# z::ensure::nonempty <value> [field-name]
# Require a non-empty value. Takes the value itself, not a variable name.
# Logs an error labelled <field-name> (default "Value") and returns 1 when
# the value is empty.
z::ensure::nonempty() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local value="$1" field_name="${2:-Value}"
    if [[ -z $value ]]; then
        zlog::error "${field_name} cannot be empty" field "$field_name"
        return 1
    fi
    return 0
}

# z::ensure::identifier <name> [context]
# Require a name made only of alphanumerics, underscores and hyphens, with
# at least one character. Suits handle and key names, which may start with a
# digit — use z::ensure::varname for shell variable names. Logs and returns
# 1 on rejection.
z::ensure::identifier() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local name="$1" context="${2:-Identifier}"
    if [[ -z $name ]]; then
        zlog::error "${context} cannot be empty" field "$context"; return 1
    fi
    if [[ $name != [[:alnum:]_-]## ]]; then
        zlog::error "Invalid ${context}" field "$context" value "$name" \
            allowed "alphanumeric, underscore, hyphen"
        return 1
    fi
    return 0
}

# z::ensure::varname <name> [context]
# Require a legal shell variable name: a letter or underscore followed by
# alphanumerics and underscores. Callers that go on to `typeset -g` the
# name depend on this to keep the assignment from being reinterpreted.
# Logs and returns 1 on rejection.
z::ensure::varname() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local name="$1" context="${2:-Variable name}"
    if [[ -z $name ]]; then
        zlog::error "${context} cannot be empty" field "$context"; return 1
    fi
    if [[ $name != [[:alpha:]_][[:alnum:]_]# ]]; then
        zlog::error "Invalid ${context}" field "$context" value "$name" \
            allowed "letter or underscore, then alphanumeric/underscore"
        return 1
    fi
    return 0
}

# z::ensure::int <value> [field-name]
# Require a canonical decimal integer — same grammar as z::is::int, so
# leading zeros, whitespace and `+` are rejected. Logs and returns 1
# otherwise.
z::ensure::int() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local value="$1" field_name="${2:-Value}"
    if [[ $value != (-[1-9][0-9]#|[0-9]|[1-9][0-9]#) ]]; then
        zlog::error "${field_name} must be an integer" field "$field_name" value "$value"
        return 1
    fi
    return 0
}

# z::ensure::int_range <value> <min> <max> [field-name]
# Require an integer within an inclusive range. Validates the boundaries
# themselves first, then the value, then that min <= max. All three are
# forced to base 10 so a zero-padded argument is not read as octal. Logs the
# specific failure and returns 1.
z::ensure::int_range() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local value="$1" field_name="${4:-Value}"
    z::ensure::nonempty "${2:-}" "min (range boundary)" || return 1
    z::ensure::nonempty "${3:-}" "max (range boundary)" || return 1
    z::ensure::int "$2" "min (range boundary)" || return 1
    z::ensure::int "$3" "max (range boundary)" || return 1
    z::ensure::int "$value" "$field_name"      || return 1
    typeset -i min_val=$(( 10#$2 )) max_val=$(( 10#$3 )) int_value=$(( 10#$value ))
    if (( min_val > max_val )); then
        zlog::error "Invalid range boundaries" field "$field_name" min "$min_val" max "$max_val"
        return 1
    fi
    if (( int_value < min_val || int_value > max_val )); then
        zlog::error "${field_name} out of range" \
            field "$field_name" value "$int_value" min "$min_val" max "$max_val"
        return 1
    fi
    return 0
}

# z::ensure::bool <value> [field-name]
# Require one of the accepted truth spellings, matched case-insensitively.
# Logs the allowed set and returns 1 otherwise.
z::ensure::bool() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local value="$1" field_name="${2:-Value}"
    case "${value:l}" in
        0|1|true|false|yes|no|on|off) return 0 ;;
        *)
            zlog::error "Invalid ${field_name}" field "$field_name" value "$value" \
                allowed "0, 1, true, false, yes, no, on, off"
            return 1 ;;
    esac
}

# z::ensure::enum <allowed|pipe|separated> <value> [field-name]
# Require the value to be one of the pipe-separated allowed values.
# Logs and returns 1 when the allowed list is empty, the value is empty, or
# the value is not a member.
# SAFETY: membership uses the (re) subscript flag, which compares the
# element literally. Plain (r) would glob-match, so an allowed entry of `*`
# or `a*` would silently accept unrelated input.
z::ensure::enum() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local allowed_values="$1" value="$2" field_name="${3:-Value}"
    local -a allowed_array
    if [[ -z $allowed_values ]]; then
        zlog::error "z::ensure::enum: allowed_values required" param "allowed_values"; return 1
    fi
    if [[ -z $value ]]; then
        zlog::error "${field_name} cannot be empty" field "$field_name" allowed "$allowed_values"
        return 1
    fi
    allowed_array=("${(@s:|:)allowed_values}")
    [[ -n ${allowed_array[(re)$value]} ]] && return 0
    zlog::error "Invalid ${field_name}" \
        field "$field_name" value "$value" allowed "$allowed_values"
    return 1
}

# z::ensure::path <path> [file|dir|any] [field-name]
# Require that a path exists, optionally with a specific kind. The type
# defaults to "any" (exists at all); an unrecognised type is itself an
# error. Logs the precise reason and returns 1.
z::ensure::path() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local p="$1" path_type="${2:-any}" field_name="${3:-Path}"
    if [[ -z $p ]]; then
        zlog::error "${field_name} cannot be empty" field "$field_name"; return 1
    fi
    case $path_type in
        file) [[ -f $p ]] || { zlog::error "${field_name} not a regular file" field "$field_name" path "$p"; return 1; } ;;
        dir)  [[ -d $p ]] || { zlog::error "${field_name} not a directory"   field "$field_name" path "$p"; return 1; } ;;
        any)  [[ -e $p ]] || { zlog::error "${field_name} does not exist"     field "$field_name" path "$p"; return 1; } ;;
        *)    zlog::error "z::ensure::path: invalid path_type" field "$field_name" path_type "$path_type" allowed "file, dir, any"; return 1 ;;
    esac
    return 0
}

# z::ensure::path::readable <path> [field-name]
# Require that a path exists and is readable by this process. Logs and
# returns 1 otherwise.
z::ensure::path::readable() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local p="$1" field_name="${2:-Path}"
    [[ -n $p ]] || { zlog::error "${field_name} cannot be empty" field "$field_name"; return 1; }
    [[ -r $p ]] || { zlog::error "${field_name} is not readable" field "$field_name" path "$p"; return 1; }
    return 0
}

# z::ensure::path::writable <path> [field-name]
# Require that a path can be written. An existing path must itself be
# writable; a missing one passes when its parent directory is writable, so
# the guard also covers "can be created here". Logs and returns 1 otherwise.
z::ensure::path::writable() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local p="$1" field_name="${2:-Path}"
    [[ -n $p ]] || { zlog::error "${field_name} cannot be empty" field "$field_name"; return 1; }
    if [[ -e $p ]]; then
        [[ -w $p ]] || { zlog::error "${field_name} is not writable" field "$field_name" path "$p"; return 1; }
    else
        local parent_dir="${p:h}"
        [[ $parent_dir == '.' ]] && parent_dir="$PWD"
        [[ -w $parent_dir ]] || {
            zlog::error "${field_name} cannot be created: parent not writable" \
                field "$field_name" path "$p" parent_dir "$parent_dir"
            return 1
        }
    fi
    return 0
}

# z::ensure::cmd <name>
# Require that the name is runnable (command, function, builtin or alias).
# Returns Z_ERR_INPUT when empty, Z_ERR_NOTFOUND when unknown — unlike the
# guards above, which return a plain 1.
z::ensure::cmd()  {
    emulate -L zsh
    z::ensure::nonempty "${1:-}" "cmd" || return $Z_ERR_INPUT
    z::is::cmd "$1" || { zlog::error "Command not found" cmd "$1"; return $Z_ERR_NOTFOUND; }
}

# z::ensure::func <name>
# Require that a shell function of this name is defined. Returns
# Z_ERR_INPUT when empty, Z_ERR_NOTFOUND when undefined. A missing function
# is logged at warn rather than error, since callers routinely probe for
# optional hooks.
z::ensure::func() {
    emulate -L zsh
    z::ensure::nonempty "${1:-}" "func" || return $Z_ERR_INPUT
    z::is::func "$1" || { zlog::warn "Function not found" func "$1"; return $Z_ERR_NOTFOUND; }
}

# z::ensure::var <name>
# Require that the named parameter is declared. Returns Z_ERR_INPUT when
# the name is empty, Z_ERR_NOTFOUND when it is not set. Declared-but-empty
# counts as set.
z::ensure::var()  {
    emulate -L zsh
    z::ensure::nonempty "${1:-}" "name" || return $Z_ERR_INPUT
    z::is::var "$1" || { zlog::error "Variable not set" name "$1"; return $Z_ERR_NOTFOUND; }
}


# =============================================================================
# VALUE QUERIES — Z::GET::
# =============================================================================
# Every function here sets REPLY before returning, on the success and the
# failure path alike, so a caller may read it unconditionally. Functions
# that log first re-assign REPLY afterwards, because zlog clobbers it.

# z::get::opt <opts-assoc-name> [short-opt] [long-opt] [default]
# Look up an option value in an options map, preferring the short form.
# Sets REPLY to the matched value or to <default>; clears REPLY2 and reply.
# A missing map name returns Z_ERR_INPUT; an absent, non-assoc or unmatched
# map is not an error and yields the default.
z::get::opt() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent noshortloops nopromptsubst
    local opts_var="${1:-}" short_opt="${2:-}" long_opt="${3:-}" default_value="${4:-}"
    typeset -i matched=0
    local -A _opts
    REPLY="$default_value"; REPLY2=""; reply=()
    if [[ -z $opts_var ]]; then
        zlog::error "z::get::opt: opts_var required" param "opts_var"; return $Z_ERR_INPUT
    fi
    if [[ -z $short_opt && -z $long_opt ]]; then
        zlog::warn "z::get::opt: both short/long empty; returning default" opts_var "$opts_var"
        REPLY="$default_value"   # zlog clobbers REPLY; restore the promised default
        return 0
    fi
    if ! z::is::assoc "$opts_var"; then
        zlog::debug "z::get::opt: not an assoc array" opts_var "$opts_var"
        REPLY="$default_value"   # ditto
        return 0
    fi
    _opts=( "${(@kvP)opts_var}" )
    if [[ -n $short_opt && -n ${_opts[-$short_opt]+x} ]]; then
        REPLY="${_opts[-$short_opt]}"; matched=1
    elif [[ -n $long_opt && -n ${_opts[--$long_opt]+x} ]]; then
        REPLY="${_opts[--$long_opt]}"; matched=1
    fi
    if zlog::if_debug; then
        local _saved="$REPLY"
        zlog::debug "z::get::opt resolved" opts_var "$opts_var" \
            short_opt "${short_opt:--}" long_opt "${long_opt:--}" matched "$matched"
        REPLY="$_saved"
    fi
    return 0
}

# z::get::opt_bool <opts-assoc-name> [short-opt] [long-opt]
# Report option presence as a value rather than a status.
# Sets REPLY to 1 when the option is present and 0 otherwise; clears REPLY2
# and reply. Always returns 0.
z::get::opt_bool() {
    emulate -L zsh; setopt extendedglob
    REPLY2=""; reply=()
    if z::is::opt "${1:-}" "${2:-}" "${3:-}"; then REPLY=1; else REPLY=0; fi
    return 0
}

# z::get::flag <opts-assoc-name> <short-flag> <long-flag> [default] [caller]
# Resolve a boolean flag from an options map: present means 1, otherwise
# <default>. Sets REPLY to 0 or 1; clears REPLY2 and reply. A <default>
# other than 0 or 1 is warned about and treated as 0. Returns Z_ERR_INPUT
# when the map name is empty, with REPLY still holding the default.
# <caller> only labels the log records, so the shorthand wrappers below can
# report their own names.
z::get::flag() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local opts_var="$1" short_flag="$2" long_flag="$3"
    local raw_default="${4:-0}" caller_name="${5:-z::get::flag}"
    REPLY2=""; reply=()
    if [[ $raw_default != 0 && $raw_default != 1 ]]; then
        zlog::warn "${caller_name}: default must be 0 or 1, got '${raw_default}'; using 0" \
            caller "$caller_name" default "$raw_default"
        raw_default=0
    fi
    typeset -i flag_val=$raw_default
    if [[ -z $opts_var ]]; then
        zlog::error "${caller_name}: opts_var required" param "opts_var"
        REPLY=$flag_val; return $Z_ERR_INPUT
    fi
    z::is::opt "$opts_var" "$short_flag" "$long_flag" && flag_val=1
    REPLY=$flag_val
    return 0
}

# -----------------------------------------------------------------------------
# Conventional flag shorthands — <opts-assoc-name> [default]
# -----------------------------------------------------------------------------
# Each resolves one of the repo's standard flags (-f/--force, -n/--dry-run,
# -v/--verbose, -q/--quiet) through z::get::flag and inherits its contract:
# REPLY is set to 0 or 1.
z::get::flag_force()   { z::get::flag "$1" 'f' 'force'   "${2:-0}" 'z::get::flag_force';   }
z::get::flag_dryrun()  { z::get::flag "$1" 'n' 'dry-run' "${2:-0}" 'z::get::flag_dryrun';  }
z::get::flag_verbose() { z::get::flag "$1" 'v' 'verbose' "${2:-0}" 'z::get::flag_verbose'; }
z::get::flag_quiet()   { z::get::flag "$1" 'q' 'quiet'   "${2:-0}" 'z::get::flag_quiet';   }

# z::get::var <name> [default]
# Read a parameter indirectly by name.
# Sets REPLY to the value or to <default> when unset, and REPLY2 to the zsh
# type string (empty when unset); clears reply. Always returns 0, so
# distinguish "unset" from "set to the default" via REPLY2.
z::get::var() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local name="${1:-}" default="${2:-}"
    REPLY="$default"; REPLY2=""; reply=()
    [[ -z $name ]] && return 0
    if z::is::var "$name"; then
        REPLY="${(P)name}"     # value
        REPLY2="${(tP)name}"   # zsh type string
    fi
    return 0
}

# z::get::cmd <name>
# Resolve how a name would run in this shell.
# Sets REPLY2 to the kind and REPLY to the detail: function body, alias
# expansion, the name itself for a builtin, or the absolute path of an
# external command. Resolution order is function, alias, builtin, external.
# Returns Z_ERR_INPUT when empty, Z_ERR_NOTFOUND when unknown.
z::get::cmd() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local cmd="${1:-}"
    REPLY=""; REPLY2=""; reply=()
    z::ensure::nonempty "$cmd" "cmd" || return $Z_ERR_INPUT
    if   (( ${+functions[$cmd]} )); then REPLY2="function"; REPLY="${functions[$cmd]}"
    elif (( ${+aliases[$cmd]}   )); then REPLY2="alias";    REPLY="${aliases[$cmd]}"
    elif (( ${+builtins[$cmd]}  )); then REPLY2="builtin";  REPLY="$cmd"
    elif (( ${+commands[$cmd]}  )); then REPLY2="external"; REPLY="${commands[$cmd]}"
    else
        zlog::error "Command not found" cmd "$cmd"; return $Z_ERR_NOTFOUND
    fi
    return 0
}

# z::get::funcs [pattern]
# Collect the names of defined functions matching a glob.
# Sets reply to the sorted matches and clears REPLY/REPLY2; nothing is
# written to stdout, so the result never pollutes a caller's capture.
# The pattern defaults to '*'; passing an explicit empty one warns once.
# Always returns 0.
z::get::funcs() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local pattern="${1:-*}"
    if [[ -z ${1:-} && $# -gt 0 ]]; then
        zlog::once "get-funcs-empty-pattern" warn \
            "z::get::funcs: empty pattern, defaulting to '*'"
    fi
    # Reset *after* logging: zlog helpers clobber REPLY.
    REPLY=""; REPLY2=""
    # Unquoted: quoting the expansion joins every match into a single element
    # (and discards the (o) ordering).
    reply=( ${(o)functions[(I)$pattern]} )
    return 0
}

# z::get::abspath <path>
# Absolutise a path logically — expand a leading `~`, `~+` or `~-`, prefix
# a relative path with $PWD, then collapse `.` and `..` through the `:a`
# modifier. Symlinks are deliberately not resolved; use z::get::realpath
# for that. Sets REPLY; clears REPLY2 and reply. Always returns 0, and the
# path need not exist.
z::get::abspath() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local p="$1"
    REPLY=""; REPLY2=""; reply=()
    case $p in
        '~')          p="$HOME" ;;
        '~/'*)        p="${HOME}/${p#'~/'}" ;;
        '~+'|'~+/'*)  p="${PWD}${p#'~+'}" ;;
        '~-'|'~-/'*)  p="${OLDPWD:-$PWD}${p#'~-'}" ;;
        [^/]*)        p="${PWD%/}/$p" ;;
    esac
    REPLY="${p:a}"
    return 0
}

# _z::get::realpath::step <path-variable-name>
# Advance one symlink hop, rewriting the named variable in place. Reads the
# link through zstat when zsh/stat is loaded and falls back to readlink(1);
# a relative target is joined to the link's own directory. Returns 1 when
# the path is not a link or the target cannot be read, which ends the walk.
_z::get::realpath::step() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local _var="$1" _cur="${(P)1}" _target=""
    if (( _Z_HAVE_ZSTAT )); then
        zstat -A _target +link -- "$_cur" 2>/dev/null || return 1
    else
        _target=$(readlink -- "$_cur" 2>/dev/null) || return 1
    fi
    [[ -z $_target ]] && return 1
    if [[ $_target == /* ]]; then
        : "${(P)_var::=$_target}"
    else
        : "${(P)_var::=${_cur:h}/$_target}"
    fi
    : "${(P)_var::=${${(P)_var}:A}}"
    return 0
}

# z::get::realpath <path>
# Resolve a path to its physical form with symlinks followed. Walks the
# links in-process rather than forking, then canonicalises what remains via
# the `:A` modifier. Sets REPLY; clears REPLY2 and reply.
# Returns Z_ERR_INPUT on an empty or all-whitespace path, and Z_ERR_GENERAL
# on a symlink cycle or on exceeding _Z_FILE_SYMLINK_MAX_ITER hops — in
# both cases REPLY holds the last path reached, not a resolved one.
z::get::realpath() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local p="${1:-}"
    REPLY=""; REPLY2=""; reply=()
    if [[ -z $p || $p == [[:space:]]# ]]; then
        zlog::error "z::get::realpath: empty path"; return $Z_ERR_INPUT
    fi
    z::get::abspath "$p"
    local current_path="$REPLY"
    typeset -A visited
    typeset -i iter=0
    if (( _Z_HAVE_ZSTAT )) || (( ${+commands[readlink]} )); then
        while [[ -L $current_path ]]; do
            (( iter += 1 ))
            if (( iter > _Z_FILE_SYMLINK_MAX_ITER )); then
                zlog::warn "z::get::realpath: max symlink iterations" \
                    path "$current_path" max "$_Z_FILE_SYMLINK_MAX_ITER"
                REPLY="$current_path"; return $Z_ERR_GENERAL
            fi
            if (( ${+visited[$current_path]} )); then
                zlog::warn "z::get::realpath: symlink cycle" path "$current_path"
                REPLY="$current_path"; return $Z_ERR_GENERAL
            fi
            visited[$current_path]=1
            _z::get::realpath::step current_path || break
        done
    fi
    # Canonicalize parent without forking; :A resolves remaining symlinks.
    current_path="${current_path:A}"
    REPLY="$current_path"
    return 0
}


# =============================================================================
# STATE MUTATORS — Z::SET::
# =============================================================================
# These change shell state and report only through their exit status; none
# of them produces a value, so the return channels are not part of their
# contract. Failures are logged and mapped onto the Z_ERR_* codes.

# z::set::var <name> <value>
# Define or overwrite a global scalar. The name is validated first, so the
# `typeset -g name=value` form cannot be steered into declaring something
# else. Returns Z_ERR_INPUT on an illegal name.
z::set::var() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local name="${1:-}" value="${2:-}"
    z::ensure::varname "$name" "name" || return $Z_ERR_INPUT
    typeset -g -- "${name}=${value}"
    zlog::if_debug && zlog::debug "Variable set" name "$name"
    return 0
}

# z::set::export <name> <value>
# Define or overwrite a global scalar and mark it exported. Same name
# validation and Z_ERR_INPUT contract as z::set::var.
z::set::export() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local name="${1:-}" value="${2:-}"
    z::ensure::varname "$name" "name" || return $Z_ERR_INPUT
    typeset -gx -- "${name}=${value}"
    zlog::if_debug && zlog::debug "Variable exported" name "$name"
    return 0
}

# z::set::unset_var <name>
# Remove a parameter from the shell. Returns Z_ERR_INPUT on an empty name,
# Z_ERR_NOTFOUND when it is not declared, Z_ERR_PERM when it is readonly,
# and Z_ERR_GENERAL if the unset itself fails.
z::set::unset_var() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local target="${1:-}"
    z::ensure::nonempty "$target" "name" || return $Z_ERR_INPUT
    (( ${+parameters[$target]} )) || return $Z_ERR_NOTFOUND
    if [[ ${(tP)target} == *readonly* ]]; then
        zlog::error "Cannot unset readonly variable" name "$target"; return $Z_ERR_PERM
    fi
    if unset -v -- "$target"; then
        zlog::if_debug && zlog::debug "Variable unset" name "$target"
        return 0
    fi
    zlog::error "Failed to unset variable" name "$target"; return $Z_ERR_GENERAL
}

# z::set::unset_func <name>
# Remove a function definition. Returns Z_ERR_INPUT on an empty name,
# Z_ERR_NOTFOUND when no such function exists, Z_ERR_GENERAL if
# unfunction fails.
z::set::unset_func() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local target="${1:-}"
    z::ensure::nonempty "$target" "func" || return $Z_ERR_INPUT
    (( ${+functions[$target]} )) || return $Z_ERR_NOTFOUND
    if unfunction -- "$target"; then
        zlog::if_debug && zlog::debug "Function unset" func "$target"
        return 0
    fi
    zlog::error "Failed to unset function" func "$target"; return $Z_ERR_GENERAL
}

# z::set::alias <name> <value>
# Define an alias. The name is rejected if it contains whitespace or `=`,
# which zsh would otherwise fold into the alias body. The registration is
# read back and verified, because assigning to aliases[] can silently fail.
# Returns Z_ERR_INPUT on bad arguments, Z_ERR_GENERAL if the alias did not
# take.
z::set::alias() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local alias_name="${1:-}" alias_value="${2:-}"
    z::ensure::nonempty "$alias_name"  "alias_name"  || return $Z_ERR_INPUT
    z::ensure::nonempty "$alias_value" "alias_value" || return $Z_ERR_INPUT
    if [[ $alias_name == *[[:space:]=]* ]]; then
        zlog::error "Invalid alias name: spaces or equals" name "$alias_name"; return $Z_ERR_INPUT
    fi
    aliases[$alias_name]="$alias_value"
    if [[ ${aliases[$alias_name]} != "$alias_value" ]]; then
        zlog::error "Alias not registered" name "$alias_name"; return $Z_ERR_GENERAL
    fi
    zlog::if_debug && zlog::debug "Alias created" name "$alias_name" value "$alias_value"
    return 0
}

# z::set::unalias <name>
# Remove an alias. Returns Z_ERR_INPUT on an empty name, Z_ERR_NOTFOUND
# when no such alias exists, Z_ERR_GENERAL if the removal fails.
z::set::unalias() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local alias_name="${1:-}"
    z::ensure::nonempty "$alias_name" "alias_name" || return $Z_ERR_INPUT
    if ! (( ${+aliases[$alias_name]} )); then
        zlog::if_debug && zlog::debug "Alias not found" name "$alias_name"
        return $Z_ERR_NOTFOUND
    fi
    if ! unset "aliases[$alias_name]"; then
        zlog::error "Failed to remove alias" name "$alias_name"; return $Z_ERR_GENERAL
    fi
    zlog::if_debug && zlog::debug "Alias removed" name "$alias_name"
    return 0
}

# z::set::path::add <dir> [prepend|append]
# Add a directory to $path, absolutising it first and defaulting to append.
# Re-hashes the command table so the change takes effect immediately, and
# is idempotent: an entry already present is logged once and skipped.
# The (Ie) subscript flag compares literally — plain (I) would treat the
# directory as a glob. A directory that does not exist is not added and
# yields Z_ERR_NOTFOUND; bad arguments yield Z_ERR_INPUT.
z::set::path::add() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local dir="${1:-}" position="${2:-append}"
    z::ensure::nonempty "$dir" "dir" || return $Z_ERR_INPUT
    z::ensure::enum "prepend|append" "$position" "position" || return $Z_ERR_INPUT
    z::get::abspath "$dir"; dir="$REPLY"
    if [[ ! -d $dir ]]; then
        zlog::debug "Directory missing, skipping PATH add" dir "$dir"; return $Z_ERR_NOTFOUND
    fi
    if (( ${path[(Ie)$dir]} )); then
        zlog::once "path-has-${dir//[^[:alnum:]]/_}" debug "Already in PATH" dir "$dir"
        return 0
    fi
    case $position in
        prepend) path=("$dir" "${path[@]}") ;;
        append)  path+=("$dir") ;;
    esac
    builtin hash -r 2>/dev/null
    zlog::debug "Added to PATH" dir "$dir" position "$position"
    return 0
}

# z::set::path::del <dir>
# Remove a directory from $path, absolutising it first, and re-hash the
# command table. Removing an absent directory is not an error. Returns
# Z_ERR_INPUT on an empty argument, 0 otherwise.
z::set::path::del() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local dir="${1:-}"
    z::ensure::nonempty "$dir" "dir" || return $Z_ERR_INPUT
    z::get::abspath "$dir"; dir="$REPLY"
    # Rebuild path[] entry by entry so the surviving order is preserved
    # exactly; a subscript deletion would renumber as it goes.
    local -a kept; local p
    for p in "${path[@]}"; do [[ $p == $dir ]] || kept+=("$p"); done
    path=("${kept[@]}")
    builtin hash -r 2>/dev/null
    zlog::debug "Removed from PATH" dir "$dir"
    return 0
}


# =============================================================================
# EFFECTS — Z::DO::
# =============================================================================
# Invocation, sourcing, command execution, and the heuristic scanner that
# guards it. Only z::do::run_async sets REPLY; the rest report through
# their exit status and pass through the status of whatever they ran.

# z::do::call <func> [args ...]
# Invoke a shell function by name and return its exit status unchanged.
# Returns Z_ERR_INPUT on an empty name and Z_ERR_NOTFOUND when no such
# function exists. Under a debug log level it also wraps the call in a
# zlog context and benchmark; the `always` block guarantees the context is
# removed even when the callee returns non-zero.
z::do::call() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local func="${1:-}"
    z::ensure::nonempty "$func" "func" || return $Z_ERR_INPUT
    shift
    if ! z::is::func "$func"; then
        zlog::warn "Function not found" func "$func"; return $Z_ERR_NOTFOUND
    fi
    typeset -i exit_code=0 _is_debug=0
    local _bench_timer="" _call_ctx=""
    zlog::if_debug && _is_debug=1
    if (( _is_debug )); then
        zlog::with_context "func" "$func"; _call_ctx="$REPLY"
        zlog::benchmark_start "z::do::call:${func}"; _bench_timer="$REPLY"
        [[ -n $_call_ctx ]] && ${_call_ctx}::debug "Calling function" argc "$#"
    fi
    {
        "$func" "$@" || exit_code=$?
    } always {
        if (( _is_debug )); then
            [[ -n $_bench_timer ]] && zlog::benchmark_end "$_bench_timer"
            (( exit_code != 0 )) && [[ -n $_call_ctx ]] && \
                ${_call_ctx}::debug "Function returned non-zero" exit_code "$exit_code"
            [[ -n $_call_ctx ]] && zlog::remove_context "$_call_ctx"
        fi
    }
    return $exit_code
}

# _z::do::source::resolve_readable <file>
# Resolve a path for z::do::source and confirm it is a readable regular
# file. Sets REPLY to the resolved absolute path; clears REPLY2 and reply.
# Symlinks are followed unless _Z_PERF_MODE is set, in which case the
# logical absolute path is used and the extra stat calls are skipped.
# Returns Z_ERR_INPUT on an empty path, Z_ERR_NOTFOUND when the file is
# missing or unreadable, or z::get::realpath's own code on failure.
_z::do::source::resolve_readable() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local file="${1:-}" resolved
    typeset -i rc=0
    typeset -g REPLY="" REPLY2=""; typeset -ga reply=()
    if [[ -z $file ]]; then
        zlog::error "z::do::source: file path required"; return $Z_ERR_INPUT
    fi
    z::get::abspath "$file"; resolved="$REPLY"
    if (( ! _Z_PERF_MODE )); then
        z::get::realpath "$resolved"; rc=$?
        if (( rc != 0 )); then
            zlog::error "z::do::source: failed to resolve" path "$file" error_code "$rc"
            return $rc
        fi
        resolved="$REPLY"
    fi
    if [[ ! -f $resolved || ! -r $resolved ]]; then
        zlog::warn "z::do::source: not readable" path "$resolved"; return $Z_ERR_NOTFOUND
    fi
    REPLY="$resolved"
    return 0
}

# z::do::source [--global] <file> [args ...]
# Source a file and return its exit status. Without --global the file is
# sourced under `emulate -L zsh`, so option changes it makes do not leak
# into the caller; --global runs it in the caller's own option state, which
# is what a file defining shell configuration needs.
# NOTE: this function deliberately omits `emulate -L zsh` itself — doing so
# would apply to the sourced file as well and defeat --global.
# Returns Z_ERR_INPUT or Z_ERR_NOTFOUND from path resolution.
z::do::source() {
    local use_global_scope=0 file="" resolved=""
    typeset -i exit_code=0
    if [[ ${1-} == --global ]]; then use_global_scope=1; shift; fi
    file="${1:-}"
    (( $# > 0 )) && shift   # bare `shift` on an empty argv is a builtin error
    _z::do::source::resolve_readable "$file" || return $?
    resolved="$REPLY"
    local _src_timer=""
    if zlog::if_debug; then
        zlog::benchmark_start "z::do::source:${resolved:t}"; _src_timer="$REPLY"
    fi
    if (( use_global_scope )); then
        builtin source "$resolved" "$@" || exit_code=$?
    else
        emulate -L zsh
        builtin source "$resolved" "$@" || exit_code=$?
    fi
    [[ -n $_src_timer ]] && zlog::benchmark_end "$_src_timer"
    (( exit_code != 0 )) && zlog::warn "z::do::source: failed" path "$resolved" exit_code "$exit_code"
    return $exit_code
}

# _z::do::run::is_init_cmd <command-string>
# Report whether the string is a bare `<tool> init <shell>` invocation of a
# tool listed in _Z_EXEC_INIT_CMDS. Sets REPLY as a side effect of
# _z::do::scan::segment_index; callers must not rely on its value.
# SAFETY: a match makes z::do::run skip BOTH the metacharacter gate and the
# dangerous-pattern scan, so this may only ever accept a single, unchained,
# literal invocation. Every token is therefore required to be a plain word,
# which rejects chaining (`;` `&&` `|`), redirection, and command
# substitution (`$(...)`, backticks) alike. Vetting only the leading
# segment would not be enough: the tail of `starship init zsh; rm -rf /`
# would then ride through unchecked.
_z::do::run::is_init_cmd() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent noshortloops nopromptsubst
    local input="${1:-}"
    local -a tok
    local t="" cmd="" cmd_base=""
    typeset -i cmd_idx=0
    [[ -n $input ]] || return 1
    tok=("${(z)input}")
    (( ${#tok} == 0 )) && return 1
    for t in "${tok[@]}"; do
        [[ $t == [[:alnum:]_.,:=+@%/-]## ]] || return 1
    done
    _z::do::scan::segment_index "${tok[@]}" || return 1
    cmd_idx=$(( 10#$REPLY ))
    cmd="${tok[cmd_idx]}"
    [[ ${tok[cmd_idx + 1]:-} == init ]] || return 1
    cmd_base="${cmd:t}"
    (( ${_Z_EXEC_INIT_CMDS[(Ie)${cmd_base}]} )) || return 1
    return 0
}

# _z::do::run::has_metachars <command-string>
# Report whether a command string contains a shell metacharacter that could
# make it a compound command. Matches _Z_EXEC_META_RE, plus backticks,
# which are tested separately because they are awkward to carry inside the
# regex. An empty string returns 1 — it has no metacharacters.
_z::do::run::has_metachars() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local input="$1"
    [[ -z $input ]] && return 1
    [[ $input =~ $_Z_EXEC_META_RE ]] || [[ $input == *'`'* ]]
}

# _z::do::scan::check_segment <cmd> [args ...]
# Vet one already-split command segment against the dangerous-pattern set
# and return 1 when it should be refused, logging at the `always` level so
# the rejection is visible whatever the log level.
# Refuses: a direct shell invocation (sh/bash/zsh/ksh/dash), a recursive
# `rm` that is also forced or --no-preserve-root and names `/`, `~` or
# $HOME, and a `dd` writing to a raw disk device. Arguments after `--` are
# still examined as paths, since they remain operands.
# NOTE: this is a heuristic denylist over an unexecuted string — it reduces
# blast radius, it does not make arbitrary input safe.
_z::do::scan::check_segment() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent noshortloops nopromptsubst
    local cmd="$1"; shift
    local -a args; (( $# > 0 )) && args=("$@")
    local cmd_base="${cmd:t}"
    case "$cmd_base" in
        sh|bash|zsh|ksh|dash)
            zlog::always "SECURITY: Direct shell invocation in scanned input" shell "$cmd_base"
            return 1 ;;
    esac
    if [[ $cmd_base == rm ]]; then
        typeset -i have_r=0 have_f=0 have_npr=0 dpc=0 past_dd=0
        local first_dp="" a
        for a in "${args[@]}"; do
            if [[ $a == '--' ]]; then (( past_dd = 1 )); continue; fi
            if (( past_dd )); then
                case $a in
                    /|/*|~|~/*|\$HOME|\$HOME/*|\${HOME}|\${HOME}/*)
                        (( dpc += 1 )); [[ -z $first_dp ]] && first_dp="$a" ;;
                esac
                continue
            fi
            case $a in
                --recursive)        (( have_r = 1 )) ;;
                --force)            (( have_f = 1 )) ;;
                --no-preserve-root) (( have_npr = 1 )) ;;
                --*) ;;
                -*) [[ $a == *r* ]] && (( have_r = 1 )); [[ $a == *f* ]] && (( have_f = 1 )) ;;
                /|/*|~|~/*|'$HOME'|'$HOME'/*|'${HOME}'|'${HOME}'/*)
                    (( dpc += 1 )); [[ -z $first_dp ]] && first_dp="$a" ;;
            esac
        done
        if (( have_r && dpc > 0 && (have_f || have_npr) )); then
            zlog::always "SECURITY: Dangerous rm detected" cmd "rm" path "$first_dp"; return 1
        fi
    fi
    if [[ $cmd_base == dd ]]; then
        local kv dev base
        for kv in "${args[@]}"; do
            if [[ $kv == of=/dev/* ]]; then
                dev="${kv#of=}"; base="${dev#/dev/}"
                case $base in
                    sd*|hd*|nvme*|disk*|rdisk*)
                        zlog::always "SECURITY: Dangerous dd detected" cmd "dd" device "$dev"; return 1 ;;
                esac
            fi
        done
    fi
    return 0
}

# _z::do::scan::segment_index <token> [token ...]
# Find which token in a segment is the actual command, skipping the parts
# that only decorate it: leading VAR=value assignments, the `nocorrect` and
# `noglob` keywords, and the option arguments of wrapper commands
# (builtin/command/time/nohup/nice/exec/env/sudo/doas).
# Sets REPLY to the 1-based index and returns 0; returns 1 when the segment
# is empty or consists only of decoration, which leaves REPLY untouched.
# SAFETY: the wrapper skipping exists so `sudo rm -rf /` is scanned as an
# `rm`, not waved through as a `sudo`.
_z::do::scan::segment_index() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent noshortloops nopromptsubst
    local -a seg; local token=""
    typeset -i i=1 seg_len=$#
    seg=("$@")
    (( seg_len > 0 )) || return 1
    while (( i <= seg_len )); do
        token="${seg[i]}"
        case $token in
            [[:alpha:]_][[:alnum:]_]#=*) (( i += 1 )) ;;
            nocorrect|noglob)            (( i += 1 )) ;;
            builtin|command|time|nohup)
                (( i += 1 ))
                while (( i <= seg_len )); do
                    case "${seg[i]}" in
                        --) (( i += 1 )); break ;;
                        -*) (( i += 1 )); continue ;;
                        *)  break ;;
                    esac
                done ;;
            nice)
                (( i += 1 ))
                while (( i <= seg_len )); do
                    case "${seg[i]}" in
                        --) (( i += 1 )); break ;;
                        -n) (( i += 2 )); continue ;;
                        [+-][0-9]##|[0-9]##) (( i += 1 )); continue ;;
                        -*) (( i += 1 )); continue ;;
                        *)  break ;;
                    esac
                done ;;
            exec)
                (( i += 1 ))
                while (( i <= seg_len )); do
                    case "${seg[i]}" in
                        --) (( i += 1 )); break ;;
                        -a) (( i += 2 )); continue ;;
                        -c|-l) (( i += 1 )); continue ;;
                        -*) (( i += 1 )); continue ;;
                        *)  break ;;
                    esac
                done ;;
            env)
                (( i += 1 ))
                while (( i <= seg_len )); do
                    case "${seg[i]}" in
                        --) (( i += 1 )); break ;;
                        -u|--unset) (( i += 2 )); continue ;;
                        [[:alpha:]_][[:alnum:]_]#=*) (( i += 1 )); continue ;;
                        -*) (( i += 1 )); continue ;;
                        *)  break ;;
                    esac
                done ;;
            sudo|doas)
                (( i += 1 ))
                while (( i <= seg_len )); do
                    case "${seg[i]}" in
                        --) (( i += 1 )); break ;;
                        -u|-g|-h|-p|-C|-c|-r|-t|-a|-D) (( i += 2 )); continue ;;
                        --user|--group|--host|--prompt|--close-from|--class|--role|--type|--chdir)
                            (( i += 2 )); continue ;;
                        [[:alpha:]_][[:alnum:]_]#=*) (( i += 1 )); continue ;;
                        -*) (( i += 1 )); continue ;;
                        *)  break ;;
                    esac
                done ;;
            *)
                REPLY="$i"; return 0 ;;
        esac
    done
    return 1
}

# _z::do::scan::patterns <command-string>
# Split a command string into segments at the control operators and run
# _z::do::scan::check_segment over each one. Returns 1 when any segment is
# refused or the fork-bomb signature is present, 0 otherwise; an empty
# string and a recognised init command both pass without inspection.
# Sets REPLY as a side effect of _z::do::scan::segment_index.
_z::do::scan::patterns() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent noshortloops nopromptsubst
    local input="${1:-}"
    local -a words seg seg_args
    local cmd="" w=""
    typeset -i cmd_idx=0
    [[ -z $input ]] && return 0
    _z::do::run::is_init_cmd "$input" && return 0
    # SAFETY: (z) tokenizes the way the shell would, so control operators
    # become words of their own and any whitespace run splits. A plain
    # (s: :) split would leave `hi;` glued together — the `rm -rf /` after
    # it would never reach check_segment as a command — and would not split
    # tab-separated argv at all.
    words=("${(z)input}")
    (( ${#words} == 0 )) && return 0
    if [[ $input =~ $_Z_EXEC_FORKBOMB_RE_1 && $input =~ $_Z_EXEC_FORKBOMB_RE_2 ]]; then
        zlog::always "SECURITY: fork bomb detected" input "$input"; return 1
    fi
    seg=()
    for w in "${words[@]}"; do
        case $w in
            '|'|'||'|'&&'|';'|'&')
                if (( ${#seg} )); then
                    if _z::do::scan::segment_index "${seg[@]}"; then
                        cmd_idx=$(( 10#$REPLY )); cmd="${seg[cmd_idx]}"
                        if (( cmd_idx < ${#seg} )); then seg_args=("${(@)seg[cmd_idx + 1,-1]}"); else seg_args=(); fi
                        _z::do::scan::check_segment "$cmd" "${seg_args[@]}" || return 1
                    fi
                    seg=()
                fi ;;
            *) seg+=("$w") ;;
        esac
    done
    if (( ${#seg} )); then
        if _z::do::scan::segment_index "${seg[@]}"; then
            cmd_idx=$(( 10#$REPLY )); cmd="${seg[cmd_idx]}"
            if (( cmd_idx < ${#seg} )); then seg_args=("${(@)seg[cmd_idx + 1,-1]}"); else seg_args=(); fi
            _z::do::scan::check_segment "$cmd" "${seg_args[@]}" || return 1
        fi
    fi
    return 0
}

# z::do::scan <command-string>
# Scan a command string for the dangerous patterns z::do::run refuses.
# Returns Z_ERR_INPUT when empty, 1 when a pattern matched, 0 otherwise.
# NOTE: the name claims only "I looked" — a clean result is not a
# certificate that the string is safe to execute.
z::do::scan() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local input="${1:-}"
    z::ensure::nonempty "$input" "input" || return $Z_ERR_INPUT
    _z::do::scan::patterns "$input"
}

# z::do::run <command-string> [timeout-seconds]
# Execute a command string in a fresh `zsh -o pipefail -c` subshell and
# return its exit status. The timeout defaults to _Z_EXEC_TIMEOUT_DEFAULT,
# is capped at _Z_EXEC_TIMEOUT_MAX, and 0 disables it; with no timeout
# binary available the command still runs, unbounded, and that is noted
# once. A timeout surfaces as exit status 124.
# Returns Z_ERR_INPUT on an empty command or a bad timeout, Z_ERR_PERM when
# the metacharacter gate rejects the string, and 1 when the pattern scan
# does.
# NOTE: the interface is string-in, so the string is parsed a second time
# by the subshell — the gate and the scan are what stand between the caller
# and that reparse. An argv interface (exec "$@") would remove the attack
# class outright; the string form is kept for the tool-init call sites in
# z::do::hook.
z::do::run() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local input="${1:-}"
    typeset -i timeout=$_Z_EXEC_TIMEOUT_DEFAULT exit_code=0
    if [[ -z $input ]]; then
        zlog::error "z::do::run: command required"; return $Z_ERR_INPUT
    fi
    if [[ -n ${2:-} ]]; then
        if [[ ${2:-} != <-> ]]; then
            zlog::error "z::do::run: timeout must be a non-negative integer" timeout "${2:-}"
            return $Z_ERR_INPUT
        fi
        timeout=$(( 10#${2} ))
        if (( timeout > _Z_EXEC_TIMEOUT_MAX )); then
            zlog::error "z::do::run: timeout exceeds max" timeout "$timeout" max "$_Z_EXEC_TIMEOUT_MAX"
            return $Z_ERR_INPUT
        fi
    fi
    if ! _z::do::run::is_init_cmd "$input"; then
        if _z::do::run::has_metachars "$input"; then
            zlog::error "z::do::run: rejected dangerous metacharacters" input "$input"
            return $Z_ERR_PERM
        fi
    fi
    _z::do::scan::patterns "$input" || return $?
    if (( timeout > 0 )) && [[ -n $_Z_EXEC_TIMEOUT_CMD ]]; then
        "$_Z_EXEC_TIMEOUT_CMD" "$timeout" zsh -o pipefail -c "$input" || exit_code=$?
        (( exit_code == 124 )) && zlog::warn "z::do::run: timeout after ${timeout}s" cmd "$input"
    else
        if (( timeout > 0 )) && [[ -z $_Z_EXEC_TIMEOUT_CMD ]]; then
            zlog::once "zbase-no-timeout-cmd" debug \
                "z::do::run: no timeout binary; running without enforcement"
        fi
        zsh -o pipefail -c "$input" || exit_code=$?
    fi
    (( exit_code != 0 && exit_code != 124 )) && \
        zlog::warn "z::do::run: command failed" exit_code "$exit_code" cmd "$input"
    return $exit_code
}

# _z::do::hook::eval_trusted <code> [label]
# Evaluate tool init code in the caller's own shell so the definitions and
# option changes it makes actually take effect. Returns Z_ERR_INPUT on
# empty input, otherwise the eval's exit status; failures are logged.
# SAFETY: this is the trust boundary. The code is neither scanned nor
# emulate-scoped, so the only caller is z::do::hook, which sources it from
# a binary the user already chose to run. Never route caller-supplied
# strings here — use z::do::run.
_z::do::hook::eval_trusted() {
    local input="${1:-}" label="${2:-unknown}"
    typeset -i exit_code=0
    if [[ -z $input ]]; then
        zlog::error "_z::do::hook::eval_trusted: input required"; return $Z_ERR_INPUT
    fi
    local _ctx=""
    if zlog::if_debug; then
        zlog::with_context "trusted_eval" "$label"; _ctx="$REPLY"
        [[ -n $_ctx ]] && ${_ctx}::debug "Trusted eval in current shell"
    fi
    builtin eval -- "$input" || exit_code=$?
    if (( exit_code != 0 )); then
        if [[ -n $_ctx ]]; then ${_ctx}::warn "Trusted eval failed" exit_code "$exit_code"
        else zlog::warn "Trusted eval failed" label "$label" exit_code "$exit_code"; fi
    fi
    [[ -n $_ctx ]] && zlog::remove_context "$_ctx"
    return $exit_code
}

# _z::do::run_async::prune
# Drop finished jobs from _Z_EXEC_ASYNC_PIDS by probing each with kill -0,
# so the cap in z::do::run_async counts only jobs that are still alive.
_z::do::run_async::prune() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local pid; local -a alive
    for pid in "${_Z_EXEC_ASYNC_PIDS[@]}"; do
        kill -0 -- "$pid" 2>/dev/null && alive+=("$pid")
    done
    _Z_EXEC_ASYNC_PIDS=("${alive[@]}")
}

# z::do::run_async <command-string> [callback-func]
# Launch a command in the background through z::do::run and record its PID.
# Sets REPLY to the PID; clears REPLY2 and reply. Returns Z_ERR_INPUT on an
# empty command and Z_ERR_GENERAL when _Z_EXEC_ASYNC_MAX_PIDS live jobs are
# already outstanding, in which case the caller must z::do::wait first.
# NOTE: <callback-func> is invoked with the exit status and captured output
# inside the child, so anything it assigns dies with that subshell and can
# never reach the parent.
z::do::run_async() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local cmd="${1:-}" callback="${2:-}" job_id
    REPLY=""; REPLY2=""; reply=()
    if [[ -z $cmd ]]; then
        zlog::error "z::do::run_async: command required"; return $Z_ERR_INPUT
    fi
    _z::do::run_async::prune
    if (( ${#_Z_EXEC_ASYNC_PIDS} >= _Z_EXEC_ASYNC_MAX_PIDS )); then
        zlog::error "z::do::run_async: PID cap reached; call z::do::wait first" \
            pending "${#_Z_EXEC_ASYNC_PIDS}" max "$_Z_EXEC_ASYNC_MAX_PIDS"
        return $Z_ERR_GENERAL
    fi
    {
        emulate -L zsh
        local result; typeset -i exit_code=0
        result=$(z::do::run "$cmd" 2>&1); exit_code=$?
        if [[ -n $callback ]] && z::is::func "$callback"; then
            "$callback" "$exit_code" "$result"
        elif (( exit_code != 0 )) && zlog::if_debug; then
            zlog::debug "z::do::run_async: job failed, no callback" exit_code "$exit_code" cmd "$cmd"
        fi
    } &
    job_id=$!
    _Z_EXEC_ASYNC_PIDS+=("$job_id")
    zlog::if_debug && zlog::debug "z::do::run_async: launched" pid "$job_id" cmd "$cmd"
    REPLY="$job_id"
    return 0
}

# z::do::wait
# Block until every job started by z::do::run_async has finished, clearing
# the PID list first so a concurrent launch is not double-waited. Returns
# the status of the last job that failed, or 0 if all succeeded; status 127
# is ignored because it means the job was already reaped.
z::do::wait() {
    emulate -L zsh; setopt extendedglob warncreateglobal typesetsilent
    local pid; local -a pending
    typeset -i wait_status=0 pid_status=0
    pending=("${_Z_EXEC_ASYNC_PIDS[@]}"); _Z_EXEC_ASYNC_PIDS=()
    for pid in "${pending[@]}"; do
        wait "$pid"; pid_status=$?
        (( pid_status != 0 && pid_status != 127 )) && wait_status=$pid_status
    done
    return $wait_status
}

# z::do::hook <tool-name> [subcommand] [shell-arg]
# Initialise a shell integration tool (starship, mise, ...) from a cached
# copy of its `<tool> <subcommand> <shell>` output, regenerating the cache
# when it is missing or stale. Defaults are "init" and "zsh". An absent
# tool is not an error and returns 0; Z_ERR_GENERAL means the tool produced
# output that could neither be sourced nor evaluated.
# SAFETY: the output of a known binary is evaluated unscanned, unlike the
# strings z::do::run accepts. The asymmetry is deliberate — the user has
# already chosen to run this tool — but it makes the cache file a code path:
# hence the 0700 directory and the atomic replace below.
z::do::hook() {
    emulate -L zsh
    local tool_name="${1:-}" subcommand="${2:-init}" shell_arg="${3:-zsh}"
    local init_code init_label cache cache_key tool_path tmp
    typeset -i tool_rc=0
    if ! z::is::cmd "$tool_name"; then
        zlog::debug "${tool_name} not found, skipping hook"; return 0
    fi
    init_label="${tool_name} ${subcommand} ${shell_arg}"
    cache_key="${tool_name}__${subcommand}__${shell_arg}"
    cache_key=${cache_key//[^a-zA-Z0-9._-]/_}
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/hooks/${cache_key}.zsh"
    tool_path="${commands[$tool_name]}"
    local _hook_timer=""
    if zlog::if_debug; then
        zlog::benchmark_start "z::do::hook:${tool_name}"; _hook_timer="$REPLY"
    fi
    # Invalidate the cache when the tool's binary is newer than it. A tool
    # that is a function or builtin has no binary to compare against, so
    # the cache is used as-is.
    if [[ -s "$cache" && ( -z "$tool_path" || ! "$tool_path" -nt "$cache" ) ]]; then
        if builtin source "$cache" 2>/dev/null; then
            [[ -n $_hook_timer ]] && zlog::benchmark_end "$_hook_timer"
            zlog::debug "${tool_name} initialized from cache" label "$init_label"
            return 0
        fi
        zlog::debug "${tool_name} cache invalid, regenerating" label "$init_label"
    fi
    init_code=$("$tool_name" "$subcommand" "$shell_arg" 2>/dev/null); tool_rc=$?
    if [[ -n $init_code ]]; then
        (( tool_rc != 0 )) && zlog::debug "${tool_name} non-zero but produced output" \
            label "$init_label" exit_code "$tool_rc"
        # SAFETY: write to a temp file and rename, so a concurrent shell
        # can never source a half-written cache; the directory is 0700
        # because everything in it is executed.
        command mkdir -p -m 700 -- "${cache:h}" 2>/dev/null
        tmp="${cache}.$$"
        if print -r -- "$init_code" > "$tmp" 2>/dev/null && command mv -f -- "$tmp" "$cache" 2>/dev/null; then
            if builtin source "$cache" 2>/dev/null; then
                [[ -n $_hook_timer ]] && zlog::benchmark_end "$_hook_timer"
                zlog::debug "${tool_name} initialized" label "$init_label"
                return 0
            fi
        else
            command rm -f -- "$tmp" 2>/dev/null
        fi
        if _z::do::hook::eval_trusted "$init_code" "$init_label"; then
            [[ -n $_hook_timer ]] && zlog::benchmark_end "$_hook_timer"
            zlog::debug "${tool_name} initialized (cache write failed)" label "$init_label"
            return 0
        fi
        [[ -n $_hook_timer ]] && zlog::benchmark_end "$_hook_timer"
        zlog::warn "Failed to initialize ${tool_name}" label "$init_label"
        return $Z_ERR_GENERAL
    fi
    [[ -n $_hook_timer ]] && zlog::benchmark_end "$_hook_timer"
    zlog::debug "${tool_name} produced no init output" label "$init_label" exit_code "$tool_rc"
    return 0
}


