# Debug-only sanity probe: catch a truncated or partially edited file by
# checking that a representative slice of the get:: surface is defined.
if (( ! _Z_PERF_MODE )) && zlog::if_debug; then
    # Not `local`: at file scope that would bind to whichever function sourced
    # us and leak the name into the caller's frame.
    typeset _z_base_probe_fn
    for _z_base_probe_fn in z::get::epoch z::get::var z::get::cmd z::get::realpath; do
        (( ${+functions[$_z_base_probe_fn]} )) || \
            zlog::warn "zbase: missing get:: surface" fn "$_z_base_probe_fn"
    done
    unset _z_base_probe_fn
fi

zlog::once "zbase-loaded" info "zbase loaded" \
    module      "zbase" \
    version     "$_Z_BASE_VERSION" \
    pid         "$$" \
    has_zstat   "$_Z_HAVE_ZSTAT" \
    timeout_cmd "${_Z_EXEC_TIMEOUT_CMD:-none}"

typeset -gi _Z_BASE_LOADED=1
