#!/usr/bin/env zsh
# =============================================================================
# ui — Terminal capability detection, progress bars, and spinners
# =============================================================================
# Description:  Terminal user-interface primitives for the z framework:
#               capability detection, cached terminal dimensions, line
#               clearing, number and duration formatting, boxed output,
#               determinate and indeterminate progress bars, named progress
#               tracks, and a self-rescheduling spinner.
#               Every rendering call writes to stderr and degrades to a
#               silent no-op when fd 2 is not a terminal or when progress
#               output is disabled, so callers need not guard their calls.
#
# Usage:        source ui           # before z; zlog optional
#               z::progress::show <current> <total> [label]
#               z::progress::finish "Loaded" --since "$start"
#
# Public API:   z::ui::*, z::util::*, z::progress::*
# Private API:  __z::ui::*, __z::progress::*, z::progress::__spinner_tick,
#               _zui_*, _zprog_*  (internal — no compatibility guarantee)
#
# Requires:     z     — z::cache::* and z::config::*, resolved lazily at
#                       call time; built-in defaults apply when z is absent
#               zlog  — zlog::debug diagnostics and the _zlog_colors palette
#               tput  — optional; fallback for terminal size detection
#
# Version:      0.6.0
# License:      MIT
# =============================================================================


# =============================================================================
# CAPABILITY DETECTION
# =============================================================================

# -----------------------------------------------------------------------------
# Cached verdicts and the active glyph table
# -----------------------------------------------------------------------------

# -1 means "not probed yet"; the predicates below latch 0 or 1 on first use.
typeset -gi _zui_unicode=-1 _zui_color=-1

# Glyph table selected once by __z::ui::init_glyphs. Every renderer reads
# these instead of embedding literal characters, so a non-UTF-8 terminal is
# handled in one place.
typeset -g _zui_glyphs_done="" _zui_glyphs_active_a="" _zui_glyphs_active_b=""
typeset -g _zui_glyphs_pending="" _zui_glyphs_fail="" _zui_glyphs_skip="" _zui_glyphs_ok=""
typeset -g _zui_glyphs_fill="" _zui_glyphs_edge="" _zui_glyphs_head="" _zui_glyphs_track=""
typeset -g _zui_glyphs_frame_l="" _zui_glyphs_frame_r="" _zui_glyphs_sep="" _zui_glyphs_arrow=""
typeset -g _zui_glyphs_block_fill="" _zui_glyphs_block_empty=""

# __z::ui::init_glyphs
# Populate the _zui_glyphs_* globals from either the Unicode or the ASCII
# glyph set, as decided by z::ui::supports_unicode. Run once at load time and
# safe to re-run after the locale or terminal changes.
__z::ui::init_glyphs() {
  emulate -L zsh

  if z::ui::supports_unicode; then
    _zui_glyphs_done='●' _zui_glyphs_active_a='◉' _zui_glyphs_active_b='◎'
    _zui_glyphs_pending='○' _zui_glyphs_fail='✗' _zui_glyphs_skip='◌' _zui_glyphs_ok='✓'
    _zui_glyphs_fill='━' _zui_glyphs_edge='▓' _zui_glyphs_head='╸' _zui_glyphs_track='─'
    _zui_glyphs_frame_l='⟨' _zui_glyphs_frame_r='⟩' _zui_glyphs_sep='│' _zui_glyphs_arrow='▸'
    _zui_glyphs_block_fill='█' _zui_glyphs_block_empty='░'
  else
    _zui_glyphs_done='#' _zui_glyphs_active_a='*' _zui_glyphs_active_b='*'
    _zui_glyphs_pending='.' _zui_glyphs_fail='x' _zui_glyphs_skip='-' _zui_glyphs_ok='v'
    _zui_glyphs_fill='=' _zui_glyphs_edge='=' _zui_glyphs_head='>' _zui_glyphs_track='-'
    _zui_glyphs_frame_l='[' _zui_glyphs_frame_r=']' _zui_glyphs_sep='|' _zui_glyphs_arrow='>'
    _zui_glyphs_block_fill='#' _zui_glyphs_block_empty='.'
  fi
}

# -----------------------------------------------------------------------------
# Capability predicates
# -----------------------------------------------------------------------------

# z::ui::is_tty [fd]
# Test whether the given file descriptor — 1 or 2, default 2 — is attached to
# a terminal. Any other value returns 1 without being tested.
z::ui::is_tty() {
  emulate -L zsh
  local stream="${1:-2}"
  case $stream in
    1) [[ -t 1 ]] ;;
    2) [[ -t 2 ]] ;;
    *) return 1 ;;
  esac
}

# z::ui::supports_color
# Report whether colour escapes may be emitted. Honours NO_COLOR, TERM=dumb,
# a non-terminal stderr, and zlog's already-resolved colour mode. The verdict
# is latched in _zui_color, so later environment changes are ignored.
z::ui::supports_color() {
  emulate -L zsh

  if (( _zui_color >= 0 )); then
    (( _zui_color )) && return 0
    return 1
  fi

  if [[ -n ${NO_COLOR-} ]] || [[ ${TERM:-} == dumb ]] || ! z::ui::is_tty 2; then
    _zui_color=0
    return 1
  fi

  if [[ -n ${_zlog_color_cache[mode]:-} && ${_zlog_color_cache[mode]} == none ]]; then
    _zui_color=0
    return 1
  fi

  if (( $+commands[tput] )) && tput setaf 1 >/dev/null 2>&1; then
    _zui_color=1
    return 0
  fi

  _zui_color=1
  return 0
}

# z::ui::supports_unicode
# Report whether the locale advertises UTF-8 on a non-dumb terminal. The
# verdict is latched in _zui_unicode.
z::ui::supports_unicode() {
  emulate -L zsh

  if (( _zui_unicode >= 0 )); then
    (( _zui_unicode )) && return 0
    return 1
  fi

  if [[ ${LANG:-}${LC_ALL:-}${LC_CTYPE:-} == *[Uu][Tt][Ff]-8* ]] &&
     [[ ${TERM:-} != dumb ]]; then
    _zui_unicode=1
    return 0
  fi

  _zui_unicode=0
  return 1
}


# =============================================================================
# TERMINAL DIMENSIONS
# =============================================================================

# __z::ui::have_cache
# Silent predicate: succeed when the z module's cache is loaded. z::cache::*
# lives in `z`, which the documented load order sources after this module, so
# the memoisation below is optional by construction. Testing for the function
# keeps that optional dependency explicit — the previous `2>/dev/null` on each
# call swallowed "command not found" and left the cache permanently dead.
__z::ui::have_cache() {
  (( ${+functions[z::cache::get]} && ${+functions[z::cache::set]} ))
}

# z::ui::width
# Print the terminal width in columns to stdout, preferring $COLUMNS, then
# tput, and falling back to 80. Memoised in z::cache with a one-second TTL
# that the resize trap also invalidates, when the z module is loaded.
z::ui::width() {
  emulate -L zsh

  typeset -i have_cache=0
  __z::ui::have_cache && have_cache=1

  local cached
  if (( have_cache )) && cached=$(z::cache::get "ui:term_width"); then
    print -r -- "$cached"
    return 0
  fi

  typeset -i width=80
  local columns_current=${COLUMNS:-}
  local tput_width

  # A non-interactive zsh sets COLUMNS=0, and 0 matches <->. Without the
  # positive test the width becomes 0, the tput and 80 fallbacks are
  # unreachable, and every consumer renders into a zero-width terminal.
  if [[ $columns_current == <-> ]] && (( 10#$columns_current > 0 )); then
    ((width = 10#$columns_current))
  elif (($+commands[tput])) &&
       tput_width=$(tput cols 2>/dev/null) &&
       [[ $tput_width == <-> ]] && (( 10#$tput_width > 0 )); then
    ((width = 10#$tput_width))
  fi

  (( have_cache )) && z::cache::set "ui:term_width" "$width" --ttl 1
  print -r -- "$width"
  return 0
}

# z::ui::height
# Print the terminal height in rows to stdout, preferring $LINES, then tput,
# and falling back to 24. Cached exactly like z::ui::width.
z::ui::height() {
  emulate -L zsh

  typeset -i have_cache=0
  __z::ui::have_cache && have_cache=1

  local cached
  if (( have_cache )) && cached=$(z::cache::get "ui:term_height"); then
    print -r -- "$cached"
    return 0
  fi

  typeset -i rows=24
  local lines_current=${LINES:-}
  local tput_height

  # $LINES is 0 in a non-interactive shell for the same reason $COLUMNS is;
  # see z::ui::width.
  if [[ $lines_current == <-> ]] && (( 10#$lines_current > 0 )); then
    ((rows = 10#$lines_current))
  elif (($+commands[tput])) &&
       tput_height=$(tput lines 2>/dev/null) &&
       [[ $tput_height == <-> ]] && (( 10#$tput_height > 0 )); then
    ((rows = 10#$tput_height))
  fi

  (( have_cache )) && z::cache::set "ui:term_height" "$rows" --ttl 1
  print -r -- "$rows"
  return 0
}

# z::ui::watch_resize
# Install a TRAPWINCH handler that drops the cached width and height so the
# next query re-measures. Does nothing when a TRAPWINCH function already
# exists, so a caller's own handler is never overwritten.
z::ui::watch_resize() {
  emulate -L zsh
  # `emulate -L` turns on LOCAL_TRAPS, which would discard the handler defined
  # below the moment this function returns, leaving the resize watch silently
  # uninstalled. The trap has to outlive the call to be of any use.
  setopt no_local_traps

  if (( ${+functions[TRAPWINCH]} )); then
    return 0
  fi

  TRAPWINCH() {
    (( ${+functions[z::cache::del]} )) || return 0
    z::cache::del "ui:term_width"
    z::cache::del "ui:term_height"
  }
  return 0
}


# =============================================================================
# TERMINAL CLEARING
# =============================================================================

# z::ui::clear_line [-f|--force] [-n|--no-newline]
# Erase the current stderr line with a carriage return and an erase-to-end
# sequence, then emit a newline unless --no-newline is given. Writes nothing
# unless fd 2 is a terminal or --force is set. Returns 1 on an unknown flag.
z::ui::clear_line() {
  emulate -L zsh

  local arg
  typeset -i force=0 newline=1

  for arg in "$@"; do
    case $arg in
    -f | --force)
      force=1
      ;;
    -n | --no-newline)
      newline=0
      ;;
    --)
      break
      ;;
    *)
      return 1
      ;;
    esac
  done

  ((force == 0)) && [[ ! -t 2 ]] && return 0

  printf '\r\e[K' >&2
  ((newline)) && printf '\n' >&2
  return 0
}

# z::ui::clear
# Clear the whole screen and home the cursor: an escape sequence on stderr
# when fd 2 is a terminal, otherwise clear(1) when stdout is.
z::ui::clear() {
  emulate -L zsh

  if [[ -t 2 ]]; then
    printf '\e[H\e[2J' >&2
  elif [[ -t 1 ]]; then
    clear
  fi

  return 0
}


# =============================================================================
# FORMATTING UTILITIES
# =============================================================================

# -----------------------------------------------------------------------------
# Numbers, durations, and text
# -----------------------------------------------------------------------------

# z::util::comma [number]
# Print the integer to stdout with thousands separators, preserving a leading
# minus sign. Anything that is not a run of digits is printed unchanged.
z::util::comma() {
  emulate -L zsh
  setopt localoptions typeset_silent

  local n="${1:-0}"
  local sign=''

  if [[ $n == -* ]]; then
    sign='-'
    n="${n#-}"
  fi

  if [[ $n != <-> ]]; then
    print -r -- "${sign}${n}"
    return 0
  fi

  typeset -i len
  ((len = ${#n}))

  if ((len <= 3)); then
    print -r -- "${sign}${n}"
    return 0
  fi

  local result="" chunk
  typeset -i pos remainder

  ((remainder = len % 3))
  if ((remainder > 0)); then
    result="${n[1,remainder]}"
    ((pos = remainder + 1))
  else
    ((pos = 1))
  fi

  while ((pos <= len)); do
    chunk="${n[pos,pos+2]}"
    if [[ -n $result ]]; then
      result="${result},${chunk}"
    else
      result="$chunk"
    fi
    ((pos += 3))
  done

  print -r -- "${sign}${result}"
  return 0
}

# z::util::truncate [text] [max-width]
# Print text to stdout shortened to max-width characters (default 12) by
# eliding the middle with a horizontal ellipsis. Returns 1 when max-width is
# not an integer; widths below 1 are clamped to 1.
z::util::truncate() {
  emulate -L zsh

  local text="${1:-}" max="${2:-12}"

  if [[ $max != <-> ]]; then
    return 1
  fi

  typeset -i max_i=${2:-12}
  (( max_i < 1 )) && max_i=1

  if (( ${#text} <= max_i )); then
    print -r -- "$text"
    return 0
  fi

  if (( max_i == 1 )); then
    print -r -- "…"
    return 0
  fi

  typeset -i keep=$(( (max_i - 1) / 2 ))
  print -r -- "${text[1,keep]}…${text: -keep}"
  return 0
}

# z::util::duration [seconds]
# Print a human-readable duration to stdout: milliseconds under one second,
# one decimal place of seconds under a minute, otherwise "Nm SSs". Input that
# is neither an integer nor a decimal is echoed with an "s" suffix.
z::util::duration() {
  emulate -L zsh

  local raw="${1:-0}"
  local -F seconds=0

  if [[ $raw == <-> ]]; then
    (( seconds = raw ))
  elif [[ $raw == *.* ]]; then
    seconds=$raw
  else
    print -r -- "${raw}s"
    return 0
  fi

  if (( seconds < 1 )); then
    printf '%.0fms\n' $(( seconds * 1000 ))
  elif (( seconds < 60 )); then
    printf '%.1fs\n' "$seconds"
  else
    typeset -i mins secs
    (( mins = seconds / 60 ))
    (( secs = seconds % 60 ))
    printf '%dm %02ds\n' "$mins" "$secs"
  fi
  return 0
}

# __z::ui::elapsed_since <stamp>
# Measure the seconds elapsed since an EPOCHREALTIME or integer epoch stamp.
# Sets REPLY to the fractional elapsed time, clamped at zero; sets REPLY to
# "" and returns 1 when stamp is empty.
__z::ui::elapsed_since() {
  emulate -L zsh
  local since="${1:-}"
  local -F now start elapsed=0

  if [[ -z $since ]]; then
    REPLY=""
    return 1
  fi

  now=${EPOCHREALTIME:-$SECONDS}
  if [[ $since == *.* ]]; then
    start=$since
  else
    start=$since.0
  fi

  elapsed=$(( now - start ))
  (( elapsed < 0 )) && elapsed=0
  REPLY=$elapsed
  return 0
}

# -----------------------------------------------------------------------------
# Boxed output
# -----------------------------------------------------------------------------

# z::ui::box <title> <width> [line ...]
# Draw the given lines inside a box on stderr, with an optional title in the
# top rule. A width of 0 or a non-integer auto-sizes from the terminal and
# caps at 80 columns; over-long lines are truncated to the inner width.
z::ui::box() {
  emulate -L zsh

  local title="${1:-}" width="${2:-0}"
  shift 2
  local -a lines=("$@")
  local line top bottom inner max_len=0
  typeset -i box_width

  if [[ $width == <-> && width -gt 0 ]]; then
    box_width=$width
  else
    box_width=$(z::ui::width)
    (( box_width > 80 )) && box_width=80
  fi

  for line in "${lines[@]}"; do
    (( ${#line} > max_len )) && max_len=${#line}
  done
  (( ${#title} + 4 > max_len )) && max_len=$(( ${#title} + 4 ))

  typeset -i inner_width=$(( box_width - 4 ))
  (( inner_width < 10 )) && inner_width=10
  (( max_len > inner_width )) && max_len=$inner_width

  printf -v top '%*s' "$(( max_len + 2 ))" ''
  top=${top// /─}
  printf -v bottom '%*s' "$(( max_len + 2 ))" ''
  bottom=${bottom// /─}

  if [[ -n $title ]]; then
    printf '┌ %s %s\n' "$title" "${top:${#title}+2}" >&2
  else
    printf '┌%s\n' "$top" >&2
  fi

  for line in "${lines[@]}"; do
    line=$(z::util::truncate "$line" "$inner_width")
    printf '│ %-*s │\n' "$max_len" "$line" >&2
  done

  printf '└%s\n' "$bottom" >&2
  return 0
}


# =============================================================================
# PROGRESS — INTERNAL ENGINE
# =============================================================================
# Everything below the public API: module state, configuration lookups, bar
# geometry, bar rendering, colour theming, and the single stderr writer.

# -----------------------------------------------------------------------------
# Module state
# -----------------------------------------------------------------------------

# Named tracks, keyed by id, each holding "current|total|label".
typeset -gA _zprog_tracks=()
# Number of track lines currently on screen; the redraw walks the cursor back
# up by exactly this many rows.
typeset -gi _zprog_track_lines=0
typeset -gi _z_progress_spinner_idx=0
typeset -gi _zprog_spinner_active=0
typeset -g _zprog_spinner_msg=""
typeset -g _zprog_phase=""

# -----------------------------------------------------------------------------
# Configuration lookups
# -----------------------------------------------------------------------------

# __z::progress::is_enabled
# Succeed when progress output is permitted, that is when the show_progress
# config key is unset or "true". Clobbers REPLY through z::config::get.
__z::progress::is_enabled() {
  emulate -L zsh
  local show_progress=""

  if z::config::get show_progress 2>/dev/null; then
    show_progress="$REPLY"
  fi

  [[ -z $show_progress || $show_progress == true ]]
}

# __z::progress::style
# Set REPLY to the configured bar style — classic, minimal, or blocks —
# falling back to classic for unset or unrecognised values.
__z::progress::style() {
  emulate -L zsh

  if z::config::get progress_style 2>/dev/null; then
    case $REPLY in
      classic | minimal | blocks) REPLY=$REPLY; return 0 ;;
    esac
  fi

  REPLY=classic
  return 0
}

# __z::progress::should_show <current> <total>
# Throttle redraws so long runs do not flood the terminal: always succeed on
# the first and last step and on every step of a short run, then fall back to
# a stride taken from the progress_update_interval config key. Returns 1 for
# non-integer arguments.
__z::progress::should_show() {
  emulate -L zsh

  [[ ${1-} == <-> && ${2-} == <-> ]] || return 1

  typeset -i current total interval=10
  local interval_raw

  ((current = 10#$1))
  ((total = 10#$2))

  interval_raw=""
  if z::config::get progress_update_interval 2>/dev/null; then
    interval_raw="$REPLY"
  fi
  if [[ $interval_raw == <-> ]]; then
    ((interval = 10#$interval_raw))
  fi
  ((interval < 1)) && interval=1

  if ((current == 1 || current == total)); then
    return 0
  fi

  if ((total <= 15)); then
    return 0
  fi

  if ((total <= 50)); then
    ((current % 5 == 0)) && return 0
    return 1
  fi

  if ((current % interval == 0)) || ((total - current < interval)); then
    return 0
  fi

  return 1
}

# -----------------------------------------------------------------------------
# Bar geometry
# -----------------------------------------------------------------------------

# __z::progress::bar_width_for_term [term-width]
# Set REPLY to the bar width in cells for a terminal of the given width
# (default 80), after reserving room for the label, percentage, and counters.
# The result is clamped to the range 8..48.
__z::progress::bar_width_for_term() {
  emulate -L zsh
  typeset -i term_width="${1:-80}" style_reserved=32 bar_width
  local style

  __z::progress::style
  style=$REPLY

  if (( term_width > 100 )); then
    (( style_reserved = 52 ))
  elif (( term_width > 70 )); then
    (( style_reserved = 42 ))
  elif (( term_width > 50 )); then
    (( style_reserved = 32 ))
  else
    (( style_reserved = 18 ))
  fi

  if [[ $style == minimal ]]; then
    (( style_reserved -= 8 ))
  fi

  (( bar_width = term_width - style_reserved ))
  (( bar_width < 8 )) && bar_width=8
  (( bar_width > 48 )) && bar_width=48
  REPLY=$bar_width
}

# __z::progress::label_width_for_term [term-width]
# Set REPLY to the width of the label column for the given terminal width
# (default 80). A REPLY of 0 means the label is dropped entirely.
__z::progress::label_width_for_term() {
  emulate -L zsh
  typeset -i term_width="${1:-80}"

  if (( term_width > 100 )); then
    REPLY=24
  elif (( term_width > 70 )); then
    REPLY=16
  elif (( term_width > 50 )); then
    REPLY=12
  else
    REPLY=0
  fi
}

# __z::progress::pulse_glyph
# Set REPLY to one of the two "active" glyphs, alternating once per second so
# the leading cell of a discrete bar appears to pulse without the caller
# having to keep any animation state.
__z::progress::pulse_glyph() {
  emulate -L zsh
  typeset -i tick=0

  if [[ -n ${EPOCHREALTIME-} ]]; then
    tick=$(( ${EPOCHREALTIME%%.*} % 2 ))
  else
    tick=$(( SECONDS % 2 ))
  fi

  if (( tick == 0 )); then
    REPLY=$_zui_glyphs_active_a
  else
    REPLY=$_zui_glyphs_active_b
  fi
}

# __z::progress::segment_count <total> <bar-width>
# Set REPLY to the number of cells the bar should use: one cell per item when
# a short run fits in the bar, otherwise the full bar width.
__z::progress::segment_count() {
  emulate -L zsh
  typeset -i total="$1" bar_width="$2"

  if (( total <= 24 && total <= bar_width )); then
    REPLY=$total
  else
    REPLY=$bar_width
  fi
}

# -----------------------------------------------------------------------------
# Bar rendering
# -----------------------------------------------------------------------------

# __z::progress::render_bar <current> <total> <bar-width>
#   [active] [fail] [skip]
# Render the uncoloured bar body and set REPLY to "<filled>|<head>|<empty>",
# the three pipe-separated segments that __z::progress::format_bar colours
# independently. A run short enough to get one cell per item is drawn in
# discrete mode, where the current cell carries the fail or skip glyph.
__z::progress::render_bar() {
  emulate -L zsh
  typeset -i current="$1" total="$2" bar_width="$3"
  typeset -i active="${4:-0}" fail="${5:-0}" skip="${6:-0}"
  typeset -i segments pos tail i edge
  local fill="" head="" empty="" done="" active_cell="" pending="" chunk style

  __z::progress::style
  style=$REPLY
  __z::progress::segment_count "$total" "$bar_width"
  (( segments = REPLY ))

  if (( total <= 24 && total <= bar_width )); then
    for (( i = 1; i <= segments; i++ )); do
      if (( i <= current )); then
        if (( fail && i == current )); then
          done+=$_zui_glyphs_fail
        elif (( skip && i == current )); then
          done+=$_zui_glyphs_skip
        else
          done+=$_zui_glyphs_done
        fi
      elif (( active && current < total && i == current + 1 )); then
        __z::progress::pulse_glyph
        active_cell="$REPLY"
      else
        pending+=$_zui_glyphs_pending
      fi
    done
    REPLY="${done}|${active_cell}|${pending}"
    return 0
  fi

  if [[ $style == blocks ]]; then
    typeset -i filled=$(( (current * segments) / total ))
    (( filled < 0 )) && filled=0
    (( filled > segments )) && filled=$segments
    if (( filled > 0 )); then
      printf -v fill '%*s' "$filled" ''
      fill=${fill// /$_zui_glyphs_block_fill}
    fi
    (( tail = segments - filled ))
    if (( tail > 0 )); then
      printf -v empty '%*s' "$tail" ''
      empty=${empty// /$_zui_glyphs_block_empty}
    fi
    REPLY="${fill}||${empty}"
    return 0
  fi

  if (( current >= total )); then
    printf -v fill '%*s' "$segments" ''
    fill=${fill// /$_zui_glyphs_fill}
    REPLY="${fill}||"
    return 0
  fi

  if (( current == 0 )); then
    printf -v empty '%*s' "$segments" ''
    empty=${empty// /$_zui_glyphs_track}
    REPLY="||${empty}"
    return 0
  fi

  (( pos = (current * segments) / total ))
  (( pos >= segments )) && (( pos = segments - 1 ))

  if (( pos > 0 )); then
    if (( pos >= 2 )); then
      (( edge = pos - 1 ))
      printf -v fill '%*s' "$edge" ''
      fill=${fill// /$_zui_glyphs_fill}
      fill+=$_zui_glyphs_edge
    else
      fill=$_zui_glyphs_edge
    fi
  fi

  head=$_zui_glyphs_head
  (( tail = segments - pos - 1 ))
  if (( tail > 0 )); then
    printf -v empty '%*s' "$tail" ''
    empty=${empty// /$_zui_glyphs_track}
  fi

  REPLY="${fill}|${head}|${empty}"
}

# __z::progress::render_indeterminate <bar-width>
# Render a fixed-size window sweeping along the track for work of unknown
# size and set REPLY to the same "<filled>|<head>|<empty>" form, with the head
# segment always empty. The window position is driven by $SECONDS.
__z::progress::render_indeterminate() {
  emulate -L zsh
  typeset -i bar_width="$1"
  typeset -i segments window=3 pos i
  local fill="" style

  __z::progress::style
  style=$REPLY
  (( segments = bar_width ))
  (( pos = SECONDS % (segments + window) ))
  (( pos > segments - window )) && (( pos = segments - window ))

  if [[ $style == blocks ]]; then
    for (( i = 0; i < segments; i++ )); do
      if (( i >= pos && i < pos + window )); then
        fill+=$_zui_glyphs_block_fill
      else
        fill+=$_zui_glyphs_block_empty
      fi
    done
    REPLY="${fill}||"
    return 0
  fi

  for (( i = 0; i < segments; i++ )); do
    if (( i >= pos && i < pos + window )); then
      fill+=$_zui_glyphs_edge
    else
      fill+=$_zui_glyphs_track
    fi
  done
  REPLY="${fill}||"
}

# __z::progress::format_bar <mode> <seg-a> <seg-b> <seg-c> [fail]
# Wrap the three rendered segments in frame glyphs and set REPLY to the
# finished bar. mode is discrete, continuous, or indeterminate and selects
# which colour roles apply. Falls back to uncoloured text when
# __z::progress::theme left the palette empty.
__z::progress::format_bar() {
  emulate -L zsh
  local mode="$1" a="$2" b="$3" c="$4"
  typeset -i fail="${5:-0}"

  if [[ -n $_zprog_t_done ]]; then
    REPLY="${_zprog_t_frame}${_zui_glyphs_frame_l}${_zprog_t_reset}"
    case $mode in
      discrete)
        [[ -n $a ]] && REPLY+="${_zprog_t_done}${a}"
        [[ -n $b ]] && REPLY+="${_zprog_t_active}${b}"
        [[ -n $c ]] && REPLY+="${_zprog_t_pending}${c}"
        ;;
      continuous | indeterminate)
        if (( fail )); then
          [[ -n $a ]] && REPLY+="${_zprog_t_fail}${a}"
        else
          [[ -n $a ]] && REPLY+="${_zprog_t_fill}${a}"
        fi
        [[ -n $b ]] && REPLY+="${_zprog_t_head}${b}${_zprog_t_edge}"
        [[ -n $c ]] && REPLY+="${_zprog_t_track}${c}"
        ;;
    esac
    REPLY+="${_zprog_t_frame}${_zui_glyphs_frame_r}${_zprog_t_reset}"
  else
    REPLY="${_zui_glyphs_frame_l}${a}${b}${c}${_zui_glyphs_frame_r}"
  fi
}

# -----------------------------------------------------------------------------
# Theming and line output
# -----------------------------------------------------------------------------

# __z::progress::theme <percent> [fail]
# Set the global _zprog_t_* colour variables for the given completion
# percentage, shifting to green near completion and to red on failure. All of
# them are cleared first and stay empty when colour is unavailable, so every
# renderer can test _zprog_t_dim to pick its plain-text branch.
__z::progress::theme() {
  emulate -L zsh
  typeset -i percent="$1" complete=0 fail="${2:-0}"

  typeset -g _zprog_t_reset="" _zprog_t_dim="" _zprog_t_bold=""
  typeset -g _zprog_t_fill="" _zprog_t_edge="" _zprog_t_track="" _zprog_t_head="" _zprog_t_frame=""
  typeset -g _zprog_t_done="" _zprog_t_active="" _zprog_t_pending="" _zprog_t_fail="" _zprog_t_skip=""
  typeset -g _zprog_t_pct="" _zprog_t_meta="" _zprog_t_sep="" _zprog_t_ok=""

  (( percent >= 100 )) && complete=1

  if ! z::ui::supports_color || (( ! ${+_zlog_colors[reset]} )); then
    return 0
  fi

  _zprog_t_reset="${_zlog_colors[reset]}"
  _zprog_t_dim="${_zlog_colors[dim]}"
  _zprog_t_bold="${_zlog_colors[bold]}"
  _zprog_t_sep="${_zlog_colors[bright_black]}"

  _zprog_t_done="${_zlog_colors[bright_cyan]}"
  _zprog_t_active="${_zlog_colors[bold]}${_zlog_colors[bright_yellow]}"
  _zprog_t_pending="${_zlog_colors[bright_black]}"
  _zprog_t_fail="${_zlog_colors[bold]}${_zlog_colors[bright_red]}"
  _zprog_t_skip="${_zlog_colors[dim]}"
  _zprog_t_ok="${_zlog_colors[bright_green]}"

  _zprog_t_fill="${_zlog_colors[cyan]}"
  _zprog_t_edge="${_zlog_colors[bright_cyan]}"
  _zprog_t_track="${_zlog_colors[bright_black]}"
  _zprog_t_head="${_zlog_colors[bold]}${_zlog_colors[white]}"
  _zprog_t_pct="${_zlog_colors[bold]}${_zlog_colors[white]}"
  _zprog_t_meta="${_zlog_colors[dim]}"
  _zprog_t_frame="${_zlog_colors[dim]}"

  if (( percent >= 90 && ! complete && ! fail )); then
    _zprog_t_fill="${_zlog_colors[green]}"
    _zprog_t_edge="${_zlog_colors[bright_green]}"
  fi

  if (( complete )); then
    _zprog_t_done="${_zlog_colors[bright_green]}"
    _zprog_t_fill="${_zlog_colors[bright_green]}"
    _zprog_t_edge="${_zlog_colors[bright_green]}${_zlog_colors[bold]}"
    _zprog_t_head="${_zlog_colors[bright_green]}${_zlog_colors[bold]}"
    _zprog_t_pct="${_zlog_colors[bright_green]}${_zlog_colors[bold]}"
  fi

  if (( fail )); then
    _zprog_t_head="${_zlog_colors[bright_red]}${_zlog_colors[bold]}"
  fi

  return 0
}

# __z::progress::format_timing <since> [current] [total]
# Set REPLY to the elapsed time and, when a rate can be extrapolated from the
# counts, an "~ETA" suffix. Sets REPLY to "" and returns 1 when since is not a
# usable stamp.
__z::progress::format_timing() {
  emulate -L zsh
  local since="${1:-}" current="${2:-0}" total="${3:-0}"
  local -F elapsed eta=0
  local elapsed_fmt eta_fmt=""

  if ! __z::ui::elapsed_since "$since"; then
    REPLY=""
    return 1
  fi

  elapsed=$REPLY
  elapsed_fmt=$(z::util::duration "$elapsed")
  elapsed_fmt="${elapsed_fmt%%$'\n'*}"

  if [[ $current == <-> && $total == <-> ]] &&
     (( current > 0 && total > current )); then
    eta=$(( (elapsed / current) * (total - current) ))
    eta_fmt=$(z::util::duration "$eta")
    eta_fmt="~${eta_fmt%%$'\n'*}"
  fi

  if [[ -n $eta_fmt ]]; then
    REPLY="${elapsed_fmt} ${eta_fmt}"
  else
    REPLY="$elapsed_fmt"
  fi
}

# __z::progress::print_line [term-width] [percent] [label-width] [newline]
#   [label] [bar] [current] [total] [timing] [detail]
# Write one progress line to stderr, choosing between a narrow, a medium, and
# a wide layout from the terminal width, the label width, and the configured
# style. The line is always rewritten in place with a carriage return and an
# erase-to-end; a trailing newline follows when the newline argument is an
# integer.
__z::progress::print_line() {
  emulate -L zsh
  typeset -i term_width="${1:-80}" percent_int="${2:-0}" label_width="${3:-0}"
  typeset -i do_newline=0
  [[ ${4:-0} == <-> ]] && (( do_newline = 4 ))

  local label_disp="${5:-}" progress_bar="${6:-}" current_fmt="${7:-}" total_fmt="${8:-}"
  local timing="${9:-}" detail="${10:-}" style

  __z::progress::style
  style=$REPLY

  if [[ -n $detail ]]; then
    if [[ -n $_zprog_t_meta ]]; then
      detail=" ${_zprog_t_sep} ${_zprog_t_meta}${detail}${_zprog_t_reset}"
    else
      detail=" ${detail}"
    fi
  fi

  if (( term_width <= 50 || label_width == 0 )); then
    if [[ -n $_zprog_t_dim ]]; then
      if [[ $style == minimal ]]; then
        printf '\r\e[K%s%s%3d%%%s %s %s/%s%s%s' \
          "$_zprog_t_dim" "$_zprog_t_pct" "$percent_int" "$_zprog_t_reset" \
          "$progress_bar" "$current_fmt" "$total_fmt" "$timing" "$_zprog_t_reset" >&2
      else
        printf '\r\e[K%s%s %s%3d%%%s %s %s/%s%s%s' \
          "$_zprog_t_dim" "$_zui_glyphs_arrow" "$_zprog_t_pct" "$percent_int" "$_zprog_t_reset" \
          "$progress_bar" "$current_fmt" "$total_fmt" "$timing" "$_zprog_t_reset" >&2
      fi
    else
      printf '\r\e[K%s %3d%% %s %s/%s%s' \
        "$_zui_glyphs_arrow" "$percent_int" "$progress_bar" \
        "$current_fmt" "$total_fmt" "$timing" >&2
    fi
  elif (( term_width > 70 )); then
    if [[ $style == minimal ]]; then
      if [[ -n $_zprog_t_dim ]]; then
        printf '\r\e[K%s%-*s%s %s%s %s│%s %3d%%%s %s│%s %s/%s%s %s' \
          "$_zprog_t_bold" "$label_width" "$label_disp" "$_zprog_t_reset" \
          "$progress_bar" "$detail" "$_zprog_t_sep" \
          "$_zprog_t_pct" "$percent_int" "$_zprog_t_reset" "$_zprog_t_sep" \
          "$_zprog_t_meta" "$current_fmt" "$total_fmt" "$_zprog_t_reset" "$timing" >&2
      else
        printf '\r\e[K%-*s %s%s │ %3d%% │ %s/%s%s' \
          "$label_width" "$label_disp" "$progress_bar" "$detail" \
          "$percent_int" "$current_fmt" "$total_fmt" "$timing" >&2
      fi
    elif [[ -n $_zprog_t_dim ]]; then
      printf '\r\e[K%s%s %s%-*s%s %s│%s%s %s│%s %3d%%%s %s│%s %s/%s%s %s' \
        "$_zprog_t_dim" "$_zui_glyphs_arrow" "$_zprog_t_bold" "$label_width" "$label_disp" "$_zprog_t_reset" \
        "$_zprog_t_sep" "$progress_bar" "$detail" "$_zprog_t_sep" \
        "$_zprog_t_pct" "$percent_int" "$_zprog_t_reset" "$_zprog_t_sep" \
        "$_zprog_t_meta" "$current_fmt" "$total_fmt" "$_zprog_t_reset" "$timing" >&2
    else
      printf '\r\e[K%s %-*s %s│ %s%s │ %3d%% │ %s/%s%s' \
        "$_zui_glyphs_arrow" "$label_width" "$label_disp" "$_zui_glyphs_sep" \
        "$progress_bar" "$detail" "$percent_int" "$current_fmt" "$total_fmt" "$timing" >&2
    fi
  else
    if [[ -n $_zprog_t_dim ]]; then
      printf '\r\e[K%s%s %s%3d%%%s %s %s/%s%s%s' \
        "$_zprog_t_dim" "$_zui_glyphs_arrow" "$_zprog_t_pct" "$percent_int" "$_zprog_t_reset" \
        "$progress_bar" "$current_fmt" "$total_fmt" "$timing" "$_zprog_t_reset" >&2
    else
      printf '\r\e[K%s %3d%% %s %s/%s%s' \
        "$_zui_glyphs_arrow" "$percent_int" "$progress_bar" \
        "$current_fmt" "$total_fmt" "$timing" >&2
    fi
  fi

  if (( do_newline )); then
    printf '\n' >&2
  fi
  return 0
}


# =============================================================================
# PROGRESS — PUBLIC API
# =============================================================================

# -----------------------------------------------------------------------------
# Single-bar progress
# -----------------------------------------------------------------------------

# z::progress::phase [name] [total]
# Record name as the current phase and print a phase header to stderr, with
# the item count in parentheses when total is an integer. The name is stored
# even when stderr is not a terminal or progress output is disabled, so later
# calls can still refer to it.
z::progress::phase() {
  emulate -L zsh

  local name="${1:-}" total="${2:-}"
  _zprog_phase="$name"

  __z::progress::is_enabled || return 0
  [[ ! -t 2 ]] && return 0

  __z::progress::theme 0
  if [[ -n $_zprog_t_dim ]]; then
    if [[ $total == <-> ]]; then
      printf '\e[K zcore %s%s %s%s (%s)%s\n' \
        "$_zprog_t_dim" "$_zui_glyphs_arrow" "$_zprog_t_bold" "$name" "$total" "$_zprog_t_reset" >&2
    else
      printf '\e[K zcore %s%s %s%s%s\n' \
        "$_zprog_t_dim" "$_zui_glyphs_arrow" "$_zprog_t_bold" "$name" "$_zprog_t_reset" >&2
    fi
  else
    if [[ $total == <-> ]]; then
      printf '\e[K zcore %s %s (%s)\n' "$_zui_glyphs_arrow" "$name" "$total" >&2
    else
      printf '\e[K zcore %s %s\n' "$_zui_glyphs_arrow" "$name" >&2
    fi
  fi
  return 0
}

# z::progress::show <current> <total> [label]
#   [--newline] [--active] [--fail] [--skip] [--since <stamp>]
#   [--detail <text>]
# Draw a determinate progress bar on stderr, rewriting the current line and
# ending it with a newline on the final step. --since enables the elapsed and
# ETA readout, --active pulses the leading cell, and --fail or --skip mark the
# current item. Succeeds silently when stderr is not a terminal, when progress
# output is disabled, or when the redraw throttle skips this step; returns 1
# on non-integer counts, a current outside 0..total, or an unknown flag.
z::progress::show() {
  emulate -L zsh

  if [[ ${1-} != <-> || ${2-} != <-> ]]; then
    zlog::debug "Invalid progress params: must be integers."
    return 1
  fi

  typeset -i current total term_width=80 percent_int bar_width newline=0
  typeset -i active=0 fail=0 skip=0
  local label="${3:-items}" label_disp detail="" since="" timing=""
  local arg term_width_raw progress_bar style
  local seg_a seg_b seg_c current_fmt total_fmt

  ((current = 10#$1))
  ((total = 10#$2))

  shift 3
  while (( $# )); do
    case $1 in
      --newline) newline=1 ;;
      --active)  active=1 ;;
      --fail)    fail=1 ;;
      --skip)    skip=1 ;;
      --since)
        shift
        since="${1:-}"
        ;;
      --detail)
        shift
        detail="${1:-}"
        ;;
      --)
        shift
        break
        ;;
      -*)
        zlog::debug "Unknown progress flag: $1"
        return 1
        ;;
      *)
        break
        ;;
    esac
    shift
  done

  if ((total <= 0 || current < 0 || current > total)); then
    zlog::debug "Invalid progress range: $current/$total."
    return 1
  fi

  if [[ ! -t 2 ]]; then
    return 0
  fi

  __z::progress::is_enabled || return 0
  __z::progress::should_show "$current" "$total" || return 0

  term_width_raw=$(z::ui::width)
  if [[ $term_width_raw == <-> ]]; then
    ((term_width = 10#$term_width_raw))
  fi

  ((percent_int = (current * 100) / total))

  typeset -i label_width=0
  __z::progress::label_width_for_term "$term_width"
  (( label_width = REPLY ))
  if (( label_width > 0 )); then
    label_disp=$(z::util::truncate "$label" "$label_width")
  else
    label_disp=""
  fi

  __z::progress::bar_width_for_term "$term_width"
  ((bar_width = REPLY))
  __z::progress::render_bar "$current" "$total" "$bar_width" "$active" "$fail" "$skip"
  seg_a="${REPLY%%|*}"
  seg_c="${REPLY##*|}"
  seg_b="${REPLY#*|}"
  seg_b="${seg_b%%|*}"

  current_fmt=$(z::util::comma "$current")
  total_fmt=$(z::util::comma "$total")
  __z::progress::theme "$percent_int" "$fail"

  if (( total <= 24 && total <= bar_width )); then
    __z::progress::format_bar discrete "$seg_a" "$seg_b" "$seg_c" "$fail"
  else
    __z::progress::format_bar continuous "$seg_a" "$seg_b" "$seg_c" "$fail"
  fi
  progress_bar="$REPLY"

  if [[ -n $since ]]; then
    __z::progress::format_timing "$since" "$current" "$total"
    timing="$REPLY"
    if [[ -n $timing && -n $_zprog_t_meta ]]; then
      timing="${_zprog_t_sep} ${_zprog_t_meta}${timing}${_zprog_t_reset}"
    elif [[ -n $timing ]]; then
      timing=" ${timing}"
    fi
  fi

  __z::progress::print_line "$term_width" "$percent_int" "$label_width" \
    "$(( newline || current == total ))" "$label_disp" "$progress_bar" \
    "$current_fmt" "$total_fmt" "$timing" "$detail"
  return 0
}

# z::progress::indeterminate [label] [--detail <text>] [--newline]
# Draw one frame of a sweeping bar on stderr for work whose size is unknown;
# call it repeatedly to animate. --newline is accepted and ignored. Returns 1
# on an unrecognised argument.
z::progress::indeterminate() {
  emulate -L zsh

  local label="${1:-Working...}" detail=""
  local arg

  shift
  while (( $# )); do
    case $1 in
      --detail)
        shift
        detail="${1:-}"
        ;;
      --newline) ;;
      *)
        return 1
        ;;
    esac
    shift
  done

  if [[ ! -t 2 ]]; then
    return 0
  fi

  __z::progress::is_enabled || return 0

  typeset -i term_width=80 bar_width
  local term_width_raw progress_bar label_disp timing=""

  term_width_raw=$(z::ui::width)
  [[ $term_width_raw == <-> ]] && (( term_width = term_width_raw ))

  typeset -i label_width=0
  __z::progress::label_width_for_term "$term_width"
  (( label_width = REPLY ))
  if (( label_width > 0 )); then
    label_disp=$(z::util::truncate "$label" "$label_width")
  fi

  __z::progress::bar_width_for_term "$term_width"
  (( bar_width = REPLY ))
  __z::progress::render_indeterminate "$bar_width"
  local seg_a="${REPLY%%|*}" seg_c="${REPLY##*|}"
  local seg_b="${REPLY#*|}"; seg_b="${seg_b%%|*}"

  __z::progress::theme 0
  __z::progress::format_bar indeterminate "$seg_a" "$seg_b" "$seg_c"
  progress_bar="$REPLY"

  __z::progress::print_line "$term_width" 0 "$label_width" 0 \
    "$label_disp" "$progress_bar" "…" "…" "$timing" "$detail"
  return 0
}

# -----------------------------------------------------------------------------
# Multi-line tracks
# -----------------------------------------------------------------------------

# z::progress::track <id> [label]
# Register a named track for the multi-line display, initialised to 0/0.
# Returns 1 when id is empty.
z::progress::track() {
  emulate -L zsh

  local id="${1:-}" label="${2:-track}"
  [[ -n $id ]] || return 1

  _zprog_tracks[$id]="0|0|${label}"
  return 0
}

# z::progress::track_update <id> <current> <total> [label]
# Store new counts for a track, creating it if needed, and redraw the whole
# block on stderr by moving the cursor up over the lines printed last time.
# Tracks are drawn in sorted key order so the block is stable between frames.
# Returns 1 on an empty id or non-integer counts.
z::progress::track_update() {
  emulate -L zsh

  local id="${1:-}" current="${2:-}" total="${3:-}" label="${4:-}"
  [[ -n $id && $current == <-> && $total == <-> ]] || return 1

  if [[ -n $label ]]; then
    _zprog_tracks[$id]="${current}|${total}|${label}"
  elif [[ -n ${_zprog_tracks[$id]:-} ]]; then
    local _cur _tot _lbl
    _cur="${_zprog_tracks[$id]%%|*}"
    _lbl="${_zprog_tracks[$id]##*|}"
    _zprog_tracks[$id]="${current}|${total}|${_lbl}"
  else
    _zprog_tracks[$id]="${current}|${total}|track"
  fi

  if [[ ! -t 2 ]] || ! __z::progress::is_enabled; then
    return 0
  fi

  typeset -i lines=${#_zprog_tracks[@]}
  if (( _zprog_track_lines > 0 )); then
    printf '\e[%dA' "$_zprog_track_lines" >&2
  fi

  local key line cur tot lbl pct
  for key in ${(ok)_zprog_tracks}; do
    line="${_zprog_tracks[$key]}"
    cur="${line%%|*}"
    tot="${line#*|}"; tot="${tot%%|*}"
    lbl="${line##*|}"
    (( pct = tot > 0 ? (cur * 100) / tot : 0 ))
    __z::progress::theme "$pct"
    if [[ -n $_zprog_t_dim ]]; then
      printf '\e[K%s%s %-12s%s %3d%% %s/%s\n' \
        "$_zprog_t_dim" "$_zui_glyphs_arrow" "$(z::util::truncate "$lbl" 12)" "$_zprog_t_reset" \
        "$pct" "$cur" "$tot" >&2
    else
      printf '\e[K%s %-12s %3d%% %s/%s\n' \
        "$_zui_glyphs_arrow" "$(z::util::truncate "$lbl" 12)" "$pct" "$cur" "$tot" >&2
    fi
  done

  _zprog_track_lines=$lines
  return 0
}

# z::progress::track_clear
# Erase the printed track block by walking the cursor back up over it and
# discard every registered track.
z::progress::track_clear() {
  emulate -L zsh

  if (( _zprog_track_lines > 0 )); then
    typeset -i i
    for (( i = 0; i < _zprog_track_lines; i++ )); do
      printf '\e[A\e[K' >&2
    done
    _zprog_track_lines=0
  fi
  _zprog_tracks=()
  return 0
}

# -----------------------------------------------------------------------------
# Completion and global switches
# -----------------------------------------------------------------------------

# z::progress::finish [label]
#   [--since <stamp>] [--detail <text>] [--warnings <n>] [--total <n>]
#   [--loaded <n>] [--no-newline]
# Tear down any bar or track block and print a final success line on stderr,
# with a summary assembled from the elapsed time, the counts, the warning
# count, and the detail text. Clears the recorded phase. Returns 1 on an
# unknown flag.
z::progress::finish() {
  emulate -L zsh

  local label="${1:-done}" since="" detail=""
  typeset -i warnings=0 total=0 loaded=0 newline=1

  shift
  while (( $# )); do
    case $1 in
      --since)
        shift
        since="${1:-}"
        ;;
      --detail)
        shift
        detail="${1:-}"
        ;;
      --warnings)
        shift
        warnings="${1:-0}"
        ;;
      --total)
        shift
        total="${1:-0}"
        ;;
      --loaded)
        shift
        loaded="${1:-0}"
        ;;
      --no-newline) newline=0 ;;
      *)
        return 1
        ;;
    esac
    shift
  done

  z::progress::track_clear
  z::ui::clear_line --no-newline

  if [[ ! -t 2 ]] || ! __z::progress::is_enabled; then
    return 0
  fi

  local summary="" elapsed_fmt=""
  if [[ -n $since ]] && __z::ui::elapsed_since "$since"; then
    elapsed_fmt=$(z::util::duration "$REPLY")
    elapsed_fmt="${elapsed_fmt%%$'\n'*}"
  fi

  if (( total > 0 )); then
    if (( loaded > 0 )); then
      summary="${loaded}/${total} modules"
    else
      summary="${total} items"
    fi
  fi

  if [[ -n $elapsed_fmt ]]; then
    summary="${summary:+$summary · }${elapsed_fmt}"
  fi
  if (( warnings > 0 )); then
    summary="${summary:+$summary · }${warnings} warning(s)"
  fi
  if [[ -n $detail ]]; then
    summary="${summary:+$summary · }${detail}"
  fi

  __z::progress::theme 100
  if [[ -n $_zprog_t_ok ]]; then
    if [[ -n $summary ]]; then
      printf '\e[K%s%s %s%s %s%s\n' \
        "$_zprog_t_ok" "$_zui_glyphs_ok" "$_zprog_t_bold" "$label" "$_zprog_t_reset" \
        "$_zprog_t_meta" "$summary" "$_zprog_t_reset" >&2
    else
      printf '\e[K%s%s %s%s\n' \
        "$_zprog_t_ok" "$_zui_glyphs_ok" "$_zprog_t_bold" "$label" "$_zprog_t_reset" >&2
    fi
  else
    printf '\e[K%s %s%s\n' "$_zui_glyphs_ok" "$label" "${summary:+ · ${summary}}" >&2
  fi

  _zprog_phase=""
  return 0
}

# z::progress::clear
# Erase the current progress line on stderr without emitting a newline, so
# the caller can print over it. No-op when progress output is disabled.
z::progress::clear() {
  emulate -L zsh
  __z::progress::is_enabled || return 0
  z::ui::clear_line --no-newline
}

# z::progress::enable
# Turn progress output on for the rest of the session by setting the
# show_progress config key to true.
z::progress::enable() {
  emulate -L zsh
  z::config::set show_progress true
}

# z::progress::disable
# Turn progress output off for the rest of the session by setting the
# show_progress config key to false.
z::progress::disable() {
  emulate -L zsh
  z::config::set show_progress false
}


# =============================================================================
# SPINNER
# =============================================================================

# z::progress::spinner [message]
# Draw a single spinner frame followed by message on stderr and advance the
# frame index. Uses Braille frames when the terminal supports Unicode and
# ASCII ones otherwise. No-op when stderr is not a terminal or progress
# output is disabled.
z::progress::spinner() {
  emulate -L zsh

  local message="${1:-Working...}"
  local -a frames=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

  if [[ ! -t 2 ]] || ! __z::progress::is_enabled; then
    return 0
  fi

  if ! z::ui::supports_unicode; then
    frames=('|' '/' '-' '\\')
  fi

  typeset -gi _z_progress_spinner_idx
  ((_z_progress_spinner_idx = (_z_progress_spinner_idx % ${#frames[@]}) + 1))

  __z::progress::theme 0
  if [[ -n $_zprog_t_dim ]]; then
    printf '\r\e[K%s%s%s%s %s%s%s' \
      "$_zprog_t_frame" "$_zui_glyphs_frame_l" "$_zprog_t_active" "${frames[_z_progress_spinner_idx]}" \
      "$_zprog_t_frame" "$_zui_glyphs_frame_r}${_zprog_t_reset} " \
      "$_zprog_t_meta" "$message" "$_zprog_t_reset" >&2
  else
    printf '\r\e[K%s %s %s' "${frames[_z_progress_spinner_idx]}" "$message" >&2
  fi
  return 0
}

# z::progress::__spinner_tick
# Redraw the spinner and reschedule itself 0.08 s later while
# _zprog_spinner_active is set; the sched chain ends as soon as it clears.
z::progress::__spinner_tick() {
  emulate -L zsh
  (( _zprog_spinner_active )) || return 0
  z::progress::spinner "$_zprog_spinner_msg"
  sched +0.08 z::progress::__spinner_tick
}

# z::progress::spinner_start [message]
# Start the self-rescheduling spinner: draw the first frame immediately and
# arm __spinner_tick through sched. Pair every call with spinner_stop or
# spinner_done, otherwise the sched chain keeps redrawing.
z::progress::spinner_start() {
  emulate -L zsh
  _zprog_spinner_msg="${1:-Working...}"
  typeset -gi _zprog_spinner_active=1
  z::progress::spinner "$_zprog_spinner_msg"
  sched +0.08 z::progress::__spinner_tick
  return 0
}

# z::progress::spinner_stop
# Stop the spinner, cancel its pending sched entry, and erase the line
# without emitting a newline.
z::progress::spinner_stop() {
  emulate -L zsh
  typeset -gi _zprog_spinner_active=0
  sched -clear z::progress::__spinner_tick 2>/dev/null
  z::ui::clear_line --no-newline
  return 0
}

# z::progress::spinner_done [message]
# Stop the spinner and replace it with a success line carrying message.
z::progress::spinner_done() {
  emulate -L zsh
  local message="${1:-Done}"

  z::progress::spinner_stop
  [[ ! -t 2 ]] || ! __z::progress::is_enabled && return 0

  __z::progress::theme 100
  if [[ -n $_zprog_t_ok ]]; then
    printf '%s%s%s %s%s\n' \
      "$_zprog_t_ok" "$_zui_glyphs_ok" "$_zprog_t_reset" \
      "$_zprog_t_meta" "$message" "$_zprog_t_reset" >&2
  else
    printf '%s %s\n' "$_zui_glyphs_ok" "$message" >&2
  fi
  return 0
}


